#!/usr/bin/env bash
# clean-merged-managed
# clean-merged: post-merge hook.
# Fires after `git pull` (incl. fast-forward — empirically verified on git 2.50.1,
# see docs/ops/clean-merged-triggers.md) and `git merge`. Runs Lane H synchronously
# (offline, reflog-safe) and spawns Lane R detached so squash-merged branches are
# also cleaned without per-session instruction.
#
# Agent-agnostic: any tool that triggers `git pull` (Claude Code, Codex, Aider,
# raw git) fires this hook.
#
# Never breaks the git op: every path exits 0; crashes/missing-deps no-op silently.

# Shared kill-switch truthiness (round-4.5 self-review: round-4 fix updated Python
# but left bash on `[ -n ]`, so CLEAN_MERGED_DISABLED=0 disabled hooks but enabled
# Python. Bash now matches Python: empty/0/false/no/off = enabled; else disabled.
# Round-5 P2: trim leading/trailing whitespace before the case so values like
# "0 " or " false" (common in dotenv/heredoc) match Python's .strip().lower().)
_cm_disabled() {
    local v="${CLEAN_MERGED_DISABLED:-}"
    # trim leading whitespace
    v="${v#"${v%%[![:space:]]*}"}"
    # trim trailing whitespace
    v="${v%"${v##*[![:space:]]}"}"
    case "$v" in
        ''|0|[Ff][Aa][Ll][Ss][Ee]|[Nn][Oo]|[Oo][Ff][Ff]) return 1 ;;
        *) return 0 ;;
    esac
}
_cm_disabled && exit 0
command -v python3 >/dev/null 2>&1 || exit 0

common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[ -n "$common_dir" ] || exit 0
main_root="$(dirname "$common_dir")"
script="$main_root/scripts/clean_merged_artifacts.py"
log_dir="$common_dir"
[ -f "$script" ] || exit 0

# Lane H: synchronous, offline, reflog-safe. Bounded work; safe to run inline.
python3 "$script" --lane h --apply --quiet >/dev/null 2>&1 || true

# Lane R: detached with strict gh timeout. Subshell + </dev/null detaches so git
# returns instantly; outputs to the audit log for forensics.
(
    python3 "$script" --reconcile --apply --quiet \
        </dev/null >>"$log_dir/clean-merged.lane-r.log" 2>&1 || true
) &

exit 0
