#!/usr/bin/env bash
# clean-merged-managed
# clean-merged: post-rewrite hook (extends Entire CLI's post-rewrite).
#
# Fires after `git pull --rebase` with divergent local (actual rebase, not FF),
# `git rebase`, and `git commit --amend`. Covers the Lane H trigger gap when an
# operator has pull.rebase=true and the local main has divergent commits.
#
# Preserves the Entire CLI post-rewrite dispatch (session linkage remap after
# amend/rebase) by invoking it first; clean-merged's Lane H runs after.
#
# Never breaks the git op: every path exits 0.

_cm_disabled() {
    local v="${CLEAN_MERGED_DISABLED:-}"
    v="${v#"${v%%[![:space:]]*}"}"
    v="${v%"${v##*[![:space:]]}"}"
    case "$v" in
        ''|0|[Ff][Aa][Ll][Ss][Ee]|[Nn][Oo]|[Oo][Ff][Ff]) return 1 ;;
        *) return 0 ;;
    esac
}

# Entire CLI post-rewrite: remap session linkage after amend/rebase rewrites.
# Preserved verbatim from the prior local hook; runs first so session state is
# remapped before any cleanup.
entire hooks git post-rewrite "${1:-}" 2>/dev/null || true

# clean-merged Lane H dispatch (offline, reflog-safe).
_cm_disabled && exit 0
command -v python3 >/dev/null 2>&1 || exit 0

common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[ -n "$common_dir" ] || exit 0
main_root="$(dirname "$common_dir")"
script="$main_root/scripts/clean_merged_artifacts.py"
[ -f "$script" ] || exit 0

python3 "$script" --lane h --apply --quiet >/dev/null 2>&1 || true

exit 0
