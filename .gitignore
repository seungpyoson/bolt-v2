.beads/
# Agent-local state must be ignored HERE (tracked .gitignore), not only in
# .git/info/exclude or the global ignore: Entire's attribution scan honors
# .gitignore alone, and unlisted local trees bloat checkpoint metadata past
# GitHub's blob limit (see PR #1231).
.entire/
.worktrees/
.devin/
.githooks/commit-msg
.githooks/post-commit
.githooks/pre-push
.githooks/prepare-commit-msg
.githooks/*.pre-entire
*.local.md
.sc/
.mcp.json
# Generated SpecKit agent adapters are NOT committed; .specify/ is the
# source of truth — regenerate locally with the spec-kit `specify` CLI
# (options recorded in .specify/init-options.json).
**/.claude/
.gemini/
.opencode/
.pi/
.codex/
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
.factory/
.antigravitycli/
.superpowers/
# Fail-closed: coding-agent state DIRS are ignored by default, including
# agents not yet in use here (names verified against vendor docs 2026-07-05);
# allowlist shared content explicitly on adoption (dir/* plus !dir/path).
# Conventional root instruction FILES (AGENTS.md style,
# .clinerules/.goosehints single-file forms) stay trackable.
.cursor/
.windsurf/
.clinerules/
.roo/
.continue/
.goose/
.amp/
.crush/
.junie/
.augment/
.kiro/
.trae/
.DS_Store
__pycache__/
*.pyc

# Issue #704: per-record source-universe execution-pack artifacts (run specs,
# execution plans, accepted-tranche manifests) are evicted to content-addressed S3
# and fingerprinted in
# specs/023-nt-research-analytics-platform/reference/evicted-fixtures.index.json.
# Keep each pack's summary + record-00000 dir (read by the execution-pack acceptance
# test); never re-commit the per-record run bulk. Enforced by
# crates/backtesting-vertical-slice/tests/backtesting_vertical_slice_reference_fixture_eviction.rs.
specs/023-nt-research-analytics-platform/reference/source-universe-execution-packs/*/execution-pack/runs/*
!specs/023-nt-research-analytics-platform/reference/source-universe-execution-packs/*/execution-pack/runs/00000-*

# Issue #704 Phase 2 Tier 1: generated source-universe reference JSON artifacts
# are evicted to the same content-addressed index. Keep hand-authored TOML specs
# plus the bybit source-universe JSON read by backfill-gate reference tests.
specs/023-nt-research-analytics-platform/reference/source-universe-conversion-work-orders/*/work-order/*.json
specs/023-nt-research-analytics-platform/reference/source-universe-batch-execution-reports/**/*.json
specs/023-nt-research-analytics-platform/reference/source-universe-conversion-queues/pmxt-polymarket-v2-current/queue/*.json
specs/023-nt-research-analytics-platform/reference/source-universe-conversion-run-plans/bybit-public-archive-tick-trades-2025-06-01-2026-06-01/run-plan/*.json
specs/023-nt-research-analytics-platform/reference/backfill-source-universes/binance-data-vision-trades-2026-03-01-all-instruments/*-source-universe.json
specs/023-nt-research-analytics-platform/reference/venue-scale-conversion-acceptance-ledgers/*/ledger/*.json
specs/023-nt-research-analytics-platform/reference/backfill-source-proofs/pmxt-polymarket-v2-current/*.json
