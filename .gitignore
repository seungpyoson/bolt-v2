/target
config/live.toml
config/live.local.toml
config/strategies/*.local.toml
/*_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_*.log
var/logs/
var/bolt-v3-live/
/tmp_tests/*.log
__pycache__/
*.pyc
.omx/
.agent-doctor/
.agents/
.beads/
