# Agent-local state must be ignored HERE (tracked .gitignore), not only in
# .git/info/exclude or the global ignore: Entire's attribution scan honors
# .gitignore alone, and unlisted local trees bloat checkpoint metadata past
# GitHub's blob limit (see PR #1231).
.entire/
.worktrees/
.devin/config.local.json
.githooks/commit-msg
.githooks/post-commit
.githooks/pre-push
.githooks/prepare-commit-msg
.githooks/*.pre-entire
*.local.md
.sc/
.mcp.json
**/.claude/*
!**/.claude/skills/
!**/.claude/skills/**
.codex/*
!.codex/config.toml
.gemini/*
!.gemini/commands/
!.gemini/commands/speckit.*.toml
.opencode/*
!.opencode/command/
!.opencode/command/speckit.*.md
.pi/*
!.pi/prompts/
!.pi/prompts/speckit.*.md
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
.factory/
.antigravitycli/
.superpowers/
# Fail-closed: coding-agent state dirs are ignored by default, including
# agents not yet in use here; allowlist shared content explicitly (see the
# .codex/.gemini/.claude patterns above).
.cursor/
.windsurf/
.cline/
.roo/
