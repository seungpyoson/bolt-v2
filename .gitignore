/slate.json
# Agent-local state must be ignored HERE (tracked .gitignore), not only in
# .git/info/exclude or the global ignore: Entire's attribution scan honors
# .gitignore alone, and unlisted local trees bloat checkpoint metadata past
# GitHub's blob limit (see PR #1231).
.entire/
.worktrees/
.devin/
# .githooks/ is enumerated (not wholesale) because it ships tracked shared
# hooks; only agent-installed machine-local hooks are ignored:
.githooks/commit-msg
.githooks/post-commit
.githooks/pre-push
.githooks/prepare-commit-msg
.githooks/*.pre-entire
# Reserved suffix: `.local.` marks machine-local, never-committed files.
*.local.md
.sc/
.mcp.json
.review/
# Generated SpecKit agent adapters are NOT committed; .specify/ templates are
# the source of truth. Regenerate locally: `specify integration install
# <agent>` (--force if the tool asks), then `git restore AGENTS.md CLAUDE.md
# GEMINI.md` — the tool appends a SPECKIT block to the agent's context file
# (codex/opencode/pi -> AGENTS.md, claude -> CLAUDE.md, gemini -> GEMINI.md).
# SpecKit integration state is machine-local:
.specify/integration.json
.specify/init-options.json
.specify/integrations/*
!.specify/integrations/speckit.manifest.json
**/.claude/
.gemini/
.opencode/
.pi/
.codex/
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
.factory/
.antigravitycli/
.superpowers/
# Fail-closed: coding-agent state DIRS are ignored by default, including
# agents not yet in use here (names verified against vendor docs 2026-07-05);
# To allowlist shared content on adoption, replace the wholesale `dir/` rule
# with `dir/*` plus `!dir/path` — nothing can be re-included under a
# trailing-slash dir rule. Conventional root instruction FILES (AGENTS.md
# style, .clinerules/.goosehints single-file forms) stay trackable.
.cursor/
.windsurf/
.clinerules/
.roo/
.continue/
.goose/
.amp/
.crush/
.junie/
.augment/
.kiro/
.trae/
.DS_Store
__pycache__/
*.pyc

# Issue #704: per-record source-universe execution-pack artifacts (run specs,
# execution plans, accepted-tranche manifests) are evicted to content-addressed S3
# and fingerprinted in
# specs/023-nt-research-analytics-platform/reference/evicted-fixtures.index.json.
# Keep each pack's summary + record-00000 dir (read by the execution-pack acceptance
# test); never re-commit the per-record run bulk. Enforced by
# crates/backtesting-vertical-slice/tests/backtesting_vertical_slice_reference_fixture_eviction.rs.
specs/023-nt-research-analytics-platform/reference/source-universe-execution-packs/*/execution-pack/runs/*
!specs/023-nt-research-analytics-platform/reference/source-universe-execution-packs/*/execution-pack/runs/00000-*

# Issue #704 Phase 2 Tier 1: generated source-universe reference JSON artifacts
# are evicted to the same content-addressed index. Keep hand-authored TOML specs
# plus the bybit source-universe JSON read by backfill-gate reference tests.
specs/023-nt-research-analytics-platform/reference/source-universe-conversion-work-orders/*/work-order/*.json
specs/023-nt-research-analytics-platform/reference/source-universe-batch-execution-reports/**/*.json
specs/023-nt-research-analytics-platform/reference/source-universe-conversion-queues/pmxt-polymarket-v2-current/queue/*.json
specs/023-nt-research-analytics-platform/reference/source-universe-conversion-run-plans/bybit-public-archive-tick-trades-2025-06-01-2026-06-01/run-plan/*.json
specs/023-nt-research-analytics-platform/reference/backfill-source-universes/binance-data-vision-trades-2026-03-01-all-instruments/*-source-universe.json
specs/023-nt-research-analytics-platform/reference/venue-scale-conversion-acceptance-ledgers/*/ledger/*.json
specs/023-nt-research-analytics-platform/reference/backfill-source-proofs/pmxt-polymarket-v2-current/*.json

# Issue #704 Phase 3: generated venue conversion batch plans are regenerated
# from committed TOML specs in tests and fingerprinted in the eviction index.
specs/023-nt-research-analytics-platform/reference/backfill-conversion-batches/*/plan/backfill-conversion-batch-plan.json

# Issue #704: generated backfill conversion completion ledgers are regenerated
# from committed TOML specs in tests and fingerprinted in the eviction index.
specs/023-nt-research-analytics-platform/reference/backfill-conversion-completion-ledgers/*/ledger/backfill-conversion-completion-ledger.json

# Issue #704 Phase 2: generated PMXT source-universe object manifests are
# regenerated from the committed source-archive-index TOML spec in tests and
# fingerprinted in the eviction index.
specs/023-nt-research-analytics-platform/reference/backfill-source-universe-object-manifests/pmxt-*/manifest/source-universe-object-manifest.json
specs/023-nt-research-analytics-platform/reference/backfill-source-universe-object-manifests/pmxt-*/category-manifests/*-object-manifest-*.json

# Issue #704 Phase 2: generated Binance source-universe operator inputs are
# regenerated from the committed TOML spec in tests and fingerprinted in the
# eviction index.
specs/023-nt-research-analytics-platform/reference/source-universe-operator-inputs/binance-?*/operator-inputs/source-universe-operator-inputs.json
