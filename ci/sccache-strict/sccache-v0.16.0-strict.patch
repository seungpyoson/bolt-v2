+    fn strict_stale_derivative_with_matching_policy_is_fatal() {
+        let temporary = tempfile::tempdir().unwrap();
+        let socket_path = temporary.path().join("server.sock");
+        let listener = UnixListener::bind(&socket_path).unwrap();
+        let server = std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            let mut length = [0; 4];
+            stream.read_exact(&mut length).unwrap();
+            let mut request = vec![0; BigEndian::read_u32(&length) as usize];
+            stream.read_exact(&mut request).unwrap();
+            assert!(matches!(
+                bincode::deserialize::<Request>(&request).unwrap(),
+                Request::GetServerIdentity
