+pub fn governed_cache_mode(config: &Config) -> Result<CacheMode> {
+    let requested = std::env::var("SCCACHE_S3_RW_MODE").ok();
+    let requested = governed_cache_mode_from_value(requested.as_deref())?;
+    governed_cache_mode_for_config(config, requested)
+}
+
+fn governed_cache_mode_for_config(config: &Config, requested: CacheMode) -> Result<CacheMode> {
+    let configs = &config.cache_configs;
+    if configs.multilevel.is_some()
+        || configs.disk.is_some()
+        || configs.azure.is_some()
+        || configs.gcs.is_some()
+        || configs.gha.is_some()
+        || configs.memcached.is_some()
+        || configs.redis.is_some()
+        || configs.webdav.is_some()
+        || configs.oss.is_some()
+        || configs.cos.is_some()
+    {
+        bail!("strict sccache permits exactly one S3 cache backend");
+    }
+
+    let configured = match &config.cache {
+        Some(CacheType::S3(s3)) => CacheMode::from(s3.rw_mode),
+        _ => bail!("strict sccache requires the governed S3 cache backend"),
+    };
+    if configured != requested {
+        bail!("configured S3 mode does not match SCCACHE_S3_RW_MODE");
+    }
+    Ok(requested)
+}
