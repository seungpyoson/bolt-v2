+            || {
+                assert!(
+                    crate::config::governed_frame_length_from_env("SCCACHE_STRICT_MAX_FRAME_BYTES")
+                        .is_err()
+                );
+            },
+        );
+    }
+
+    #[test]
+    fn strict_timeout_policy_is_loaded_as_one_unit() {
+        temp_env::with_vars(
+            [
+                ("SCCACHE_STRICT_STARTUP_TIMEOUT_MS", Some("11")),
+                ("SCCACHE_STRICT_IPC_TIMEOUT_MS", Some("12")),
+                ("SCCACHE_STRICT_CACHE_READ_TIMEOUT_MS", Some("13")),
+                ("SCCACHE_STRICT_CACHE_WRITE_TIMEOUT_MS", Some("14")),
+            ],
+            || {
+                let timeouts = StrictTimeouts::from_env().unwrap();
+                assert_eq!(timeouts.startup, Duration::from_millis(11));
+                assert_eq!(timeouts.ipc, Duration::from_millis(12));
+                assert_eq!(timeouts.cache_read, Duration::from_millis(13));
+                assert_eq!(timeouts.cache_write, Duration::from_millis(14));
+            },
+        );
+    }
