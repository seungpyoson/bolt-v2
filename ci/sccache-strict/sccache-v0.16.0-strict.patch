+pub fn connect_with_timeout(
+    addr: &SocketAddr,
+    timeout: std::time::Duration,
+) -> std::io::Result<Box<dyn Connection>> {
+    match addr {
+        SocketAddr::Net(addr) => std::net::TcpStream::connect_timeout(addr, timeout)
+            .map(|stream| Box::new(stream) as Box<dyn Connection>),
+        #[cfg(unix)]
+        SocketAddr::Unix(path) => std::os::unix::net::UnixStream::connect(path)
+            .map(|stream| Box::new(stream) as Box<dyn Connection>),
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        SocketAddr::UnixAbstract(path) => {
+            let address = std::os::unix::net::SocketAddr::from_abstract_name(path)?;
+            std::os::unix::net::UnixStream::connect_addr(&address)
+                .map(|stream| Box::new(stream) as Box<dyn Connection>)
+        }
+    }
+}
