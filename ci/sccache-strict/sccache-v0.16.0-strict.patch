+impl StagedCacheRead {
+    #[cfg(unix)]
+    fn rollback(outputs: &mut [StagedOutput]) -> Result<()> {
+        let mut first_error = None;
+        for output in outputs.iter_mut().rev() {
+            if let Err(error) = output.rollback()
+                && first_error.is_none()
+            {
+                first_error = Some(error);
+            }
+        }
+        if let Some(error) = first_error {
+            return Err(error).context("failed to roll back cache-hit output commit");
+        }
+        Ok(())
+    }
+
+    #[cfg(unix)]
+    fn commit(self, deadline: Option<StrictDeadline>) -> Result<(Vec<u8>, Vec<u8>)> {
+        let Self {
+            stdout,
+            stderr,
+            mut outputs,
+        } = self;
+        for index in 0..outputs.len() {
+            if deadline.is_some_and(StrictDeadline::is_elapsed) {
+                Self::rollback(&mut outputs)?;
+                bail!("governed cache materialization deadline expired before commit");
+            }
+            if let Err(error) = outputs[index].commit() {
+                Self::rollback(&mut outputs)?;
+                return Err(error);
+            }
+            if deadline.is_some_and(StrictDeadline::is_elapsed) {
+                Self::rollback(&mut outputs)?;
+                bail!("governed cache materialization deadline expired during commit");
+            }
+        }
+        for output in &mut outputs {
+            output.finalize()?;
+        }
+        Ok((stdout, stderr))
+    }
+
+    #[cfg(not(unix))]
+    fn commit(self, _deadline: Option<StrictDeadline>) -> Result<(Vec<u8>, Vec<u8>)> {
+        bail!("strict cache materialization requires Unix descriptor-relative output support")
+    }
+}
