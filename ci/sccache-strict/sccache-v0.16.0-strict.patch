+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CompilerEnvironment {
+    entries: Vec<ConsumerEnvironmentEntry>,
+}
+
+impl CompilerEnvironment {
+    pub fn entries(&self) -> &[ConsumerEnvironmentEntry] {
+        &self.entries
+    }
+
+    pub fn canonical_key_component(&self) -> Vec<u8> {
+        let mut component = b"strict-compiler-environment-v1\0".to_vec();
+        component.extend_from_slice(&(self.entries.len() as u64).to_be_bytes());
+        for entry in &self.entries {
+            component.push(1);
+            component.extend_from_slice(&(entry.name.len() as u64).to_be_bytes());
+            component.extend_from_slice(&entry.name);
+            component.extend_from_slice(&(entry.value.len() as u64).to_be_bytes());
+            component.extend_from_slice(&entry.value);
+        }
+        component
+    }
+
+    #[cfg(unix)]
+    pub(crate) fn os_entries(&self) -> Vec<(OsString, OsString)> {
+        self.entries
+            .iter()
+            .map(|entry| {
+                (
+                    OsString::from_vec(entry.name.clone()),
+                    OsString::from_vec(entry.value.clone()),
+                )
+            })
+            .collect()
+    }
+
+    #[cfg(all(test, unix))]
+    pub fn for_tests(entries: Vec<(Vec<u8>, Vec<u8>)>) -> Self {
+        let mut entries = entries
+            .into_iter()
+            .map(|(name, value)| ConsumerEnvironmentEntry { name, value })
+            .collect::<Vec<_>>();
+        entries.sort_by(|left, right| left.name.cmp(&right.name));
+        Self { entries }
+    }
+}
