+#[derive(Debug)]
+struct StrictPoisonInner {
+    state: std::sync::atomic::AtomicU8,
+    notify: tokio::sync::Notify,
+    commit_waker: futures::task::AtomicWaker,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum StrictCommitGate {
+    Acquired,
+    Busy,
+    Poisoned,
+}
+
+impl StrictPoison {
+    pub fn new() -> Self {
+        Self {
+            inner: Arc::new(StrictPoisonInner {
+                state: std::sync::atomic::AtomicU8::new(0),
+                notify: tokio::sync::Notify::new(),
+                commit_waker: futures::task::AtomicWaker::new(),
+            }),
+        }
+    }
+
+    pub fn is_healthy(&self) -> bool {
+        self.inner.state.load(std::sync::atomic::Ordering::Acquire) <= 1
+    }
+
+    pub fn poison(&self) {
+        loop {
+            let state = self.inner.state.load(std::sync::atomic::Ordering::Acquire);
+            let next = match state {
+                0 => 3,
+                1 => 2,
+                2 | 3 => return,
+                _ => unreachable!("strict poison state is invalid"),
+            };
+            if self
+                .inner
+                .state
+                .compare_exchange(
+                    state,
+                    next,
+                    std::sync::atomic::Ordering::AcqRel,
+                    std::sync::atomic::Ordering::Acquire,
+                )
+                .is_ok()
+            {
+                self.inner.notify.notify_waiters();
+                self.inner.commit_waker.wake();
+                return;
+            }
+        }
+    }
+
+    pub(crate) fn terminate_on_deadline(&self) {
+        self.inner
+            .state
+            .store(3, std::sync::atomic::Ordering::Release);
+        self.inner.notify.notify_waiters();
+        self.inner.commit_waker.wake();
+        #[cfg(not(test))]
+        std::process::exit(1);
+    }
+
+    #[cfg(test)]
+    pub(crate) fn is_terminal(&self) -> bool {
+        self.inner.state.load(std::sync::atomic::Ordering::Acquire) == 3
+    }
+
+    pub(crate) fn try_acquire_commit_gate(&self) -> StrictCommitGate {
+        match self.inner.state.compare_exchange(
+            0,
+            1,
+            std::sync::atomic::Ordering::AcqRel,
+            std::sync::atomic::Ordering::Acquire,
+        ) {
+            Ok(_) => StrictCommitGate::Acquired,
+            Err(1) => StrictCommitGate::Busy,
+            Err(2 | 3) => StrictCommitGate::Poisoned,
+            Err(_) => unreachable!("strict poison state is invalid"),
+        }
+    }
+
+    pub(crate) fn register_commit_waker(&self, waker: &std::task::Waker) {
+        self.inner.commit_waker.register(waker);
+    }
+
+    pub(crate) fn release_commit_gate(&self) {
+        loop {
+            let state = self.inner.state.load(std::sync::atomic::Ordering::Acquire);
+            let next = match state {
+                1 => 0,
+                2 => 3,
+                _ => return,
+            };
+            if self
+                .inner
+                .state
+                .compare_exchange(
+                    state,
+                    next,
+                    std::sync::atomic::Ordering::AcqRel,
+                    std::sync::atomic::Ordering::Acquire,
+                )
+                .is_ok()
+            {
+                self.inner.commit_waker.wake();
+                if next == 3 {
+                    self.inner.notify.notify_waiters();
+                }
+                return;
+            }
+        }
+    }
+
+    pub async fn poisoned(&self) {
+        loop {
+            let notified = self.inner.notify.notified();
+            if self.inner.state.load(std::sync::atomic::Ordering::Acquire) >= 2 {
+                return;
+            }
+            notified.await;
+        }
+    }
+}
