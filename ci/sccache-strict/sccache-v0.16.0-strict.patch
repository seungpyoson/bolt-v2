+#[cfg(target_os = "linux")]
+fn linux_process_record(pid: i32) -> io::Result<Option<(u8, i32)>> {
+    match std::fs::read(format!("/proc/{pid}/stat")) {
+        Ok(bytes) => parse_linux_proc_stat(&bytes)
+            .map(Some)
+            .ok_or_else(|| io::Error::other("strict child /proc stat is malformed")),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(error),
+    }
+}
