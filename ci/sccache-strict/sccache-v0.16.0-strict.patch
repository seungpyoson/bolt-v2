+    fn strict_server_refuses_to_replace_a_live_unix_socket() {
+        let runtime = Runtime::new().unwrap();
+        let temporary = tempfile::tempdir().unwrap();
+        let path = temporary.path().join("server.sock");
+        let _guard = runtime.enter();
+        let (listener, ownership) =
+            bind_governed_unix_listener(&path, Duration::from_millis(25)).unwrap();
+
+        let replacement = bind_governed_unix_listener(&path, Duration::from_millis(25));
+
+        assert!(replacement.is_err());
+        drop(listener);
+        remove_owned_unix_socket(ownership).unwrap();
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn strict_server_recovers_an_unchanged_stale_unix_socket() {
+        let runtime = Runtime::new().unwrap();
+        let temporary = tempfile::tempdir().unwrap();
+        let path = temporary.path().join("server.sock");
+        std::os::unix::net::UnixListener::bind(&path).unwrap();
+
+        let _guard = runtime.enter();
+        let (listener, ownership) =
+            bind_governed_unix_listener(&path, Duration::from_millis(25)).unwrap();
+
+        drop(listener);
+        remove_owned_unix_socket(ownership).unwrap();
+        assert!(!path.exists());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn strict_server_cleanup_preserves_replacement_socket_inode() {
+        let runtime = Runtime::new().unwrap();
+        let temporary = tempfile::tempdir().unwrap();
+        let path = temporary.path().join("server.sock");
+        let _guard = runtime.enter();
+        let (listener, ownership) =
+            bind_governed_unix_listener(&path, Duration::from_millis(25)).unwrap();
+        drop(listener);
+        fs::remove_file(&path).unwrap();
+        let replacement = std::os::unix::net::UnixListener::bind(&path).unwrap();
+
+        remove_owned_unix_socket(ownership).unwrap();
+
+        assert!(path.exists());
+        drop(replacement);
+    }
+
+    #[test]
+    fn strict_server_refuses_an_occupied_tcp_port() {
+        let occupied = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = occupied.local_addr().unwrap();
+        let runtime = Runtime::new().unwrap();
+
+        let replacement = runtime.block_on(bind_governed_tcp_listener(&address));
+
+        assert_eq!(replacement.unwrap_err().kind(), io::ErrorKind::AddrInUse);
+    }
