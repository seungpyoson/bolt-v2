+#[cfg(unix)]
+fn acquire_unix_socket_lock(path: &Path) -> io::Result<fs::File> {
+    use std::os::fd::AsRawFd;
+
+    let lock = fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(unix_socket_lock_path(path))?;
+    let result = unsafe { libc::flock(lock.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) };
+    if result != 0 {
+        let source = io::Error::last_os_error();
+        return Err(io::Error::new(
+            io::ErrorKind::AddrInUse,
+            format!("governed Unix socket ownership lock is held: {source}"),
+        ));
+    }
+    Ok(lock)
+}
