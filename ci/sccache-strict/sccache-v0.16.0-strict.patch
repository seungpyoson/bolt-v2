+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StrictDeadline(std::time::Instant);
+
+impl StrictDeadline {
+    pub fn from_now(name: &str, duration: std::time::Duration) -> Result<Self> {
+        Self::checked_from(name, std::time::Instant::now(), duration)
+    }
+
+    pub fn checked_from(
+        name: &str,
+        start: std::time::Instant,
+        duration: std::time::Duration,
+    ) -> Result<Self> {
+        start
+            .checked_add(duration)
+            .map(Self)
+            .with_context(|| format!("{name} exceeds the platform monotonic-clock range"))
+    }
+
+    pub fn checked_sequence_from(
+        name: &str,
+        start: std::time::Instant,
+        durations: impl IntoIterator<Item = std::time::Duration>,
+    ) -> Result<Self> {
+        durations
+            .into_iter()
+            .try_fold(Self(start), |deadline, duration| {
+                deadline
+                    .0
+                    .checked_add(duration)
+                    .map(Self)
+                    .with_context(|| format!("{name} exceeds the platform monotonic-clock range"))
+            })
+    }
+
+    pub fn remaining(self) -> Option<std::time::Duration> {
+        self.0
+            .checked_duration_since(std::time::Instant::now())
+            .filter(|remaining| !remaining.is_zero())
+    }
+
+    pub fn is_elapsed(self) -> bool {
+        self.0 <= std::time::Instant::now()
+    }
+
+    pub fn tokio_instant(self) -> tokio::time::Instant {
+        tokio::time::Instant::from_std(self.0)
+    }
+}
+
+pub fn governed_duration_from_value(name: &str, value: &str) -> Result<std::time::Duration> {
+    if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+        bail!("{name} must be a positive decimal millisecond value");
+    }
+    let millis = value
+        .parse::<u64>()
+        .with_context(|| format!("{name} must fit in an unsigned 64-bit integer"))?;
+    if millis == 0 {
+        bail!("{name} must be greater than zero");
+    }
+    let compiled_maximum = governed_positive_u64_from_value(
+        "compiled maximum runtime timeout",
+        env!("SCCACHE_STRICT_MAX_RUNTIME_TIMEOUT_MS"),
+    )?;
+    if millis > compiled_maximum {
+        bail!("{name} exceeds the compiled maximum runtime timeout");
+    }
+    let duration = std::time::Duration::from_millis(millis);
+    if std::time::Instant::now().checked_add(duration).is_none() {
+        bail!("{name} exceeds the platform monotonic-clock range");
+    }
+    Ok(duration)
+}
+
+#[test]
+fn strict_deadline_accepts_the_exact_compiled_maximum() {
+    let maximum = governed_duration_from_value(
+        "strict deadline maximum",
+        env!("SCCACHE_STRICT_MAX_RUNTIME_TIMEOUT_MS"),
+    )
+    .unwrap();
+    let deadline = StrictDeadline::from_now("strict deadline maximum", maximum).unwrap();
+    assert!(deadline.remaining().is_some());
+}
+
+#[test]
+fn strict_deadline_rejects_monotonic_clock_overflow() {
+    assert!(
+        StrictDeadline::checked_from(
+            "strict deadline overflow",
+            std::time::Instant::now(),
+            std::time::Duration::MAX,
+        )
+        .is_err()
+    );
+}
+
+#[test]
+fn strict_deadline_rejects_sequence_overflow() {
+    assert!(
+        StrictDeadline::checked_sequence_from(
+            "strict deadline sequence",
+            std::time::Instant::now(),
+            [
+                std::time::Duration::MAX,
+                std::time::Duration::from_millis(1),
+            ],
+        )
+        .is_err()
+    );
+}
+
+pub fn governed_positive_u64_from_value(name: &str, value: &str) -> Result<u64> {
+    if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+        bail!("{name} must be a positive decimal integer");
+    }
+    let parsed = value
+        .parse::<u64>()
+        .with_context(|| format!("{name} must fit in an unsigned 64-bit integer"))?;
+    if parsed == 0 {
+        bail!("{name} must be greater than zero");
+    }
+    Ok(parsed)
+}
