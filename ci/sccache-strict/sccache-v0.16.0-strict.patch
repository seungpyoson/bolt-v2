+#[cfg(unix)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum DestinationIdentity {
+    Missing,
+    Regular { device: u64, inode: u64 },
+}
+
+#[cfg(unix)]
+struct PinnedParent {
+    path: PathBuf,
+    directory: std::fs::File,
+    device: u64,
+    inode: u64,
+}
+
+#[cfg(unix)]
+impl PinnedParent {
+    fn open(path: &Path) -> Result<(Self, OsString)> {
+        let parent = path
+            .parent()
+            .context("cache output destination has no parent directory")?;
+        let basename = path
+            .file_name()
+            .context("cache output destination has no basename")?
+            .to_owned();
+        let mut options = std::fs::OpenOptions::new();
+        options
+            .read(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_DIRECTORY | libc::O_NOFOLLOW);
+        let directory = options
+            .open(parent)
+            .context("failed to pin cache output parent directory")?;
+        let metadata = directory
+            .metadata()
+            .context("failed to inspect pinned cache output parent")?;
+        ensure!(
+            metadata.file_type().is_dir(),
+            "cache output parent is not a directory"
+        );
+        Ok((
+            Self {
+                path: parent.to_path_buf(),
+                directory,
+                device: metadata.dev(),
+                inode: metadata.ino(),
+            },
+            basename,
+        ))
+    }
+
+    fn descriptor(&self) -> i32 {
+        self.directory.as_raw_fd()
+    }
+
+    fn revalidate(&self) -> Result<()> {
+        let metadata =
+            fs::symlink_metadata(&self.path).context("failed to revalidate cache output parent")?;
+        ensure!(
+            metadata.file_type().is_dir()
+                && metadata.dev() == self.device
+                && metadata.ino() == self.inode,
+            "cache output parent identity changed"
+        );
+        Ok(())
+    }
+
+    fn destination_identity(&self, basename: &OsStr) -> Result<DestinationIdentity> {
+        let basename = c_name(basename)?;
+        let mut stat = std::mem::MaybeUninit::<libc::stat>::uninit();
+        let result = unsafe {
+            libc::fstatat(
+                self.descriptor(),
+                basename.as_ptr(),
+                stat.as_mut_ptr(),
+                libc::AT_SYMLINK_NOFOLLOW,
+            )
+        };
+        if result != 0 {
+            let error = std::io::Error::last_os_error();
+            if error.kind() == std::io::ErrorKind::NotFound {
+                return Ok(DestinationIdentity::Missing);
+            }
+            return Err(error).context("failed to inspect cache output destination");
+        }
+        let stat = unsafe { stat.assume_init() };
+        ensure!(
+            stat.st_mode & libc::S_IFMT == libc::S_IFREG && stat.st_nlink == 1,
+            "refusing to replace a non-transactional cache output destination"
+        );
+        Ok(DestinationIdentity::Regular {
+            device: stat.st_dev as u64,
+            inode: stat.st_ino as u64,
+        })
+    }
+
+    fn create_temporary(&self, prefix: &str) -> Result<(OsString, std::fs::File)> {
+        let name = OsString::from(format!(".{prefix}-{}", uuid::Uuid::new_v4().simple()));
+        let name_c = c_name(&name)?;
+        let descriptor = unsafe {
+            libc::openat(
+                self.descriptor(),
+                name_c.as_ptr(),
+                libc::O_CLOEXEC | libc::O_CREAT | libc::O_EXCL | libc::O_NOFOLLOW | libc::O_RDWR,
+                0o600,
+            )
+        };
+        if descriptor < 0 {
+            return Err(std::io::Error::last_os_error())
+                .context("failed to create cache output staging file");
+        }
+        Ok((name, unsafe { std::fs::File::from_raw_fd(descriptor) }))
+    }
+
+    fn rename(&self, source: &OsStr, destination: &OsStr) -> Result<()> {
+        let source = c_name(source)?;
+        let destination = c_name(destination)?;
+        let result = unsafe {
+            libc::renameat(
+                self.descriptor(),
+                source.as_ptr(),
+                self.descriptor(),
+                destination.as_ptr(),
+            )
+        };
+        if result == 0 {
+            Ok(())
+        } else {
+            Err(std::io::Error::last_os_error()).context("cache output rename failed")
+        }
+    }
+
+    #[cfg(target_os = "linux")]
+    fn rename_no_replace(&self, source: &OsStr, destination: &OsStr) -> Result<()> {
+        let source = c_name(source)?;
+        let destination = c_name(destination)?;
+        let result = unsafe {
+            libc::syscall(
+                libc::SYS_renameat2,
+                self.descriptor(),
+                source.as_ptr(),
+                self.descriptor(),
+                destination.as_ptr(),
+                libc::RENAME_NOREPLACE,
+            )
+        };
+        if result == 0 {
+            Ok(())
+        } else {
+            Err(std::io::Error::last_os_error()).context("cache output no-replace rename failed")
+        }
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    fn rename_no_replace(&self, source: &OsStr, destination: &OsStr) -> Result<()> {
+        ensure!(
+            self.destination_identity(destination)? == DestinationIdentity::Missing,
+            "cache output destination appeared before no-replace rename"
+        );
+        self.rename(source, destination)
+    }
+
+    #[cfg(target_os = "linux")]
+    fn exchange(&self, left: &OsStr, right: &OsStr) -> Result<()> {
+        let left = c_name(left)?;
+        let right = c_name(right)?;
+        let result = unsafe {
+            libc::syscall(
+                libc::SYS_renameat2,
+                self.descriptor(),
+                left.as_ptr(),
+                self.descriptor(),
+                right.as_ptr(),
+                libc::RENAME_EXCHANGE,
+            )
+        };
+        if result == 0 {
+            Ok(())
+        } else {
+            Err(std::io::Error::last_os_error()).context("cache output exchange rename failed")
+        }
+    }
+
+    #[cfg(target_os = "linux")]
+    fn move_to_reserved_backup(
+        &self,
+        destination: &OsStr,
+        backup: &OsStr,
+        expected: DestinationIdentity,
+    ) -> Result<()> {
+        self.exchange(destination, backup)?;
+        match self.destination_identity(backup) {
+            Ok(actual) if actual == expected => {}
+            Ok(_) => {
+                self.exchange(destination, backup)
+                    .context("failed to reverse mismatched cache output exchange")?;
+                bail!("cache output destination identity changed during commit");
+            }
+            Err(error) => {
+                self.exchange(destination, backup)
+                    .context("failed to reverse unverifiable cache output exchange")?;
+                return Err(error);
+            }
+        }
+        if let Err(error) = self.unlink(destination) {
+            self.exchange(destination, backup)
+                .context("failed to reverse cache output exchange after unlink failure")?;
+            return Err(error);
+        }
+        Ok(())
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    fn move_to_reserved_backup(
+        &self,
+        destination: &OsStr,
+        backup: &OsStr,
+        expected: DestinationIdentity,
+    ) -> Result<()> {
+        self.rename(destination, backup)?;
+        match self.destination_identity(backup) {
+            Ok(actual) if actual == expected => Ok(()),
+            Ok(_) => {
+                self.rename(backup, destination)
+                    .context("failed to reverse mismatched cache output backup")?;
+                bail!("cache output destination identity changed during commit");
+            }
+            Err(error) => {
+                self.rename(backup, destination)
+                    .context("failed to reverse unverifiable cache output backup")?;
+                Err(error)
+            }
+        }
+    }
+
+    fn unlink(&self, name: &OsStr) -> Result<()> {
+        let name = c_name(name)?;
+        let result = unsafe { libc::unlinkat(self.descriptor(), name.as_ptr(), 0) };
+        if result == 0 {
+            Ok(())
+        } else {
+            Err(std::io::Error::last_os_error()).context("cache output unlink failed")
+        }
+    }
+}
+
+#[cfg(unix)]
+fn c_name(name: &OsStr) -> Result<CString> {
+    CString::new(name.as_bytes()).context("cache output basename contains a NUL byte")
+}
+
+#[cfg(unix)]
+struct StagedOutput {
+    parent: PinnedParent,
+    basename: OsString,
+    initial: DestinationIdentity,
+    staged: DestinationIdentity,
+    stage_name: Option<OsString>,
+    backup_name: Option<OsString>,
+    committed: bool,
+}
+
+#[cfg(not(unix))]
+struct StagedOutput;
+
+#[cfg(unix)]
+impl StagedOutput {
+    fn stage(path: &Path) -> Result<(Self, std::fs::File)> {
+        let (parent, basename) = PinnedParent::open(path)?;
+        let initial = parent.destination_identity(&basename)?;
+        let (stage_name, temporary) = parent.create_temporary("sccache-stage")?;
+        let metadata = temporary
+            .metadata()
+            .context("failed to inspect cache output staging file")?;
+        let staged = DestinationIdentity::Regular {
+            device: metadata.dev(),
+            inode: metadata.ino(),
+        };
+        Ok((
+            Self {
+                parent,
+                basename,
+                initial,
+                staged,
+                stage_name: Some(stage_name),
+                backup_name: None,
+                committed: false,
+            },
+            temporary,
+        ))
+    }
+
+    fn identity_key(&self) -> (u64, u64, Vec<u8>) {
+        (
+            self.parent.device,
+            self.parent.inode,
+            self.basename.as_bytes().to_vec(),
+        )
+    }
+
+    fn commit(&mut self) -> Result<()> {
+        self.parent.revalidate()?;
+        ensure!(
+            self.parent.destination_identity(&self.basename)? == self.initial,
+            "cache output destination identity changed before commit"
+        );
+        if matches!(self.initial, DestinationIdentity::Regular { .. }) {
+            let (backup_name, reservation) = self.parent.create_temporary("sccache-backup")?;
+            if let Err(error) =
+                self.parent
+                    .move_to_reserved_backup(&self.basename, &backup_name, self.initial)
+            {
+                drop(reservation);
+                return Err(error);
+            }
+            drop(reservation);
+            self.backup_name = Some(backup_name);
+        }
+        let stage_name = self
+            .stage_name
+            .as_ref()
+            .context("cache output staging authority was already consumed")?;
+        if let Err(commit_error) = self.parent.rename_no_replace(stage_name, &self.basename) {
+            if let Some(backup_name) = self.backup_name.as_ref() {
+                self.parent
+                    .rename_no_replace(backup_name, &self.basename)
+                    .context("failed to restore cache output after commit failure")?;
+                self.backup_name = None;
+            }
+            return Err(commit_error);
+        }
+        self.stage_name = None;
+        self.committed = true;
+        ensure!(
+            self.parent.destination_identity(&self.basename)? == self.staged,
+            "cache output staging identity changed during commit"
+        );
+        Ok(())
+    }
+
+    fn rollback(&mut self) -> Result<()> {
+        if !self.committed {
+            return Ok(());
+        }
+        ensure!(
+            self.parent.destination_identity(&self.basename)? == self.staged,
+            "committed cache output identity changed before rollback"
+        );
+        self.parent.unlink(&self.basename)?;
+        if let Some(backup_name) = self.backup_name.as_ref() {
+            self.parent.rename_no_replace(backup_name, &self.basename)?;
+            self.backup_name = None;
+        }
+        self.committed = false;
+        Ok(())
+    }
+
+    fn finalize(&mut self) -> Result<()> {
+        self.parent.revalidate()?;
+        if let Some(backup_name) = self.backup_name.as_ref() {
+            self.parent.unlink(backup_name)?;
+            self.backup_name = None;
+        }
+        Ok(())
+    }
+}
