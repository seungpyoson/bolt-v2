+    handshake: ConsumerHandshakePolicy,
+}
+
+impl StrictClientControls {
+    pub fn snapshot_digest(&self) -> &str {
+        &self.snapshot_digest
+    }
+
+    pub(crate) fn address(&self) -> Result<crate::net::SocketAddr> {
+        #[cfg(any(target_os = "linux", target_os = "android"))]
+        {
+            return Ok(crate::net::SocketAddr::UnixAbstract(
+                self.abstract_socket_name.clone(),
+            ));
+        }
+        #[cfg(not(any(target_os = "linux", target_os = "android")))]
+        bail!("strict consumer transport requires Linux abstract Unix sockets")
+    }
+
+    pub(crate) fn timeouts(&self) -> Result<StrictTimeouts> {
+        Ok(StrictTimeouts {
+            startup: governed_duration_from_value(
+                "consumer startup timeout",
+                &self.timeouts.startup_ms.to_string(),
+            )?,
+            ipc: governed_duration_from_value(
+                "consumer IPC-frame timeout",
+                &self.timeouts.ipc_frame_ms.to_string(),
+            )?,
+            cache_read: governed_duration_from_value(
+                "consumer cache-read timeout",
+                &self.timeouts.cache_read_ms.to_string(),
+            )?,
+            cache_write: governed_duration_from_value(
+                "consumer required-write timeout",
+                &self.timeouts.required_write_ms.to_string(),
+            )?,
+        })
+    }
+
+    pub(crate) fn server_identity(&self) -> StrictServerIdentity {
+        StrictServerIdentity {
+            protocol_version: self.handshake.protocol_version,
+            derivative_identity: self.handshake.derivative_identity.clone(),
+            config_fingerprint: self.snapshot_digest.clone(),
+            cache_mode: self.handshake.cache_mode.clone(),
+            startup_timeout_ms: self.timeouts.startup_ms,
+            ipc_timeout_ms: self.timeouts.ipc_frame_ms,
+            cache_read_timeout_ms: self.timeouts.cache_read_ms,
+            cache_write_timeout_ms: self.timeouts.required_write_ms,
+            max_frame_bytes: self.max_frame_bytes,
+        }
+    }
+}
