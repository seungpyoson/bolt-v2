+    pub fn new(
+        exe: OsString,
+        cwd: OsString,
+        args: Vec<OsString>,
+        env_vars: Vec<(OsString, OsString)>,
+        compiler_family: StrictCompilerFamily,
+        snapshot_digest: String,
+    ) -> Self {
+        let request_digest = strict_request_digest(
+            &exe,
+            &cwd,
+            &args,
+            &env_vars,
+            compiler_family,
+            &snapshot_digest,
+        );
+        Self {
+            exe,
+            cwd,
+            args,
+            env_vars,
+            compiler_family,
+            binding: StrictResponseBinding {
+                request_digest,
+                snapshot_digest,
+            },
+        }
+    }
+
+    #[cfg(unix)]
+    pub fn has_valid_digest(&self) -> bool {
+        self.binding.request_digest
+            == strict_request_digest(
+                &self.exe,
+                &self.cwd,
+                &self.args,
+                &self.env_vars,
+                self.compiler_family,
+                &self.binding.snapshot_digest,
+            )
+    }
+}
+
+#[cfg(unix)]
+fn strict_request_digest(
+    exe: &OsString,
+    cwd: &OsString,
+    args: &[OsString],
+    env_vars: &[(OsString, OsString)],
+    compiler_family: StrictCompilerFamily,
+    snapshot_digest: &str,
+) -> [u8; 32] {
+    fn frame(hasher: &mut blake3::Hasher, bytes: &[u8]) {
+        hasher.update(&(bytes.len() as u64).to_be_bytes());
+        hasher.update(bytes);
+    }
+
+    let mut hasher = blake3::Hasher::new();
+    hasher.update(b"sccache-strict-classified-request-v1\0");
+    frame(&mut hasher, snapshot_digest.as_bytes());
+    hasher.update(&[match compiler_family {
+        StrictCompilerFamily::Rust => 1,
+        StrictCompilerFamily::Gcc => 2,
+        StrictCompilerFamily::Clang => 3,
+    }]);
+    frame(&mut hasher, exe.as_os_str().as_bytes());
+    frame(&mut hasher, cwd.as_os_str().as_bytes());
+    hasher.update(&(args.len() as u64).to_be_bytes());
+    for arg in args {
+        frame(&mut hasher, arg.as_os_str().as_bytes());
+    }
+    hasher.update(&(env_vars.len() as u64).to_be_bytes());
+    for (name, value) in env_vars {
+        frame(&mut hasher, name.as_os_str().as_bytes());
+        frame(&mut hasher, value.as_os_str().as_bytes());
+    }
+    *hasher.finalize().as_bytes()
+}
+
+pub fn strict_environment_key_component<'a, I>(entries: I) -> Vec<u8>
+where
+    I: IntoIterator<Item = (&'a [u8], &'a [u8])>,
+{
+    let entries = entries.into_iter().collect::<Vec<_>>();
+    let mut component = b"strict-compiler-environment-v1\0".to_vec();
+    component.extend_from_slice(&(entries.len() as u64).to_be_bytes());
+    for (name, value) in entries {
+        component.push(1);
+        component.extend_from_slice(&(name.len() as u64).to_be_bytes());
+        component.extend_from_slice(name);
+        component.extend_from_slice(&(value.len() as u64).to_be_bytes());
+        component.extend_from_slice(value);
+    }
+    component
+}
