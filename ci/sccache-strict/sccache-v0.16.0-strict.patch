+enum StagedOutput {
+    Persist {
+        temporary: NamedTempFile,
+        path: PathBuf,
+        mode: Option<u32>,
+    },
+    Copy {
+        temporary: std::fs::File,
+        path: PathBuf,
+        mode: Option<u32>,
+    },
+}
+
+impl StagedOutput {
+    fn path(&self) -> &Path {
+        match self {
+            Self::Persist { path, .. } | Self::Copy { path, .. } => path,
+        }
+    }
+
+    fn permits_special_destination(&self) -> bool {
+        match self {
+            Self::Persist { .. } => false,
+            Self::Copy { path, .. } => is_stream_destination(path),
+        }
+    }
+
+    fn commit(self) -> Result<()> {
+        match self {
+            Self::Persist {
+                temporary,
+                path,
+                mode,
+            } => {
+                temporary.persist(&path)?;
+                if let Some(mode) = mode {
+                    set_file_mode(path.as_path(), mode)?;
+                }
+            }
+            Self::Copy {
+                mut temporary,
+                path,
+                mode,
+            } => {
+                temporary.rewind()?;
+                let mut destination = fs::File::create(&path)?;
+                std::io::copy(&mut temporary, &mut destination)?;
+                if let Some(mode) = mode {
+                    set_file_mode(path.as_path(), mode)?;
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+enum DestinationBackup {
+    Missing(PathBuf),
+    Regular {
+        path: PathBuf,
+        temporary: std::fs::File,
+        mode: Option<u32>,
+    },
+    Special,
+}
+
+impl DestinationBackup {
+    fn capture(path: &Path, permits_special_destination: bool) -> Result<Self> {
+        let metadata = match fs::symlink_metadata(path) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                return Ok(Self::Missing(path.to_path_buf()));
+            }
+            Err(error) => return Err(error.into()),
+        };
+        if !metadata.file_type().is_file() {
+            if permits_special_destination {
+                return Ok(Self::Special);
+            }
+            bail!("refusing to replace a non-regular cache output destination");
+        }
+        let mut source = fs::File::open(path)?;
+        let mode = get_file_mode(&source)?;
+        let mut temporary = tempfile()?;
+        std::io::copy(&mut source, &mut temporary)?;
+        Ok(Self::Regular {
+            path: path.to_path_buf(),
+            temporary,
+            mode,
+        })
+    }
+
+    fn restore(self) -> Result<()> {
+        match self {
+            Self::Missing(path) => match fs::remove_file(path) {
+                Ok(()) => Ok(()),
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+                Err(error) => Err(error.into()),
+            },
+            Self::Regular {
+                path,
+                mut temporary,
+                mode,
+            } => {
+                temporary.rewind()?;
+                let directory = path
+                    .parent()
+                    .context("cache output destination has no parent directory")?;
+                let mut destination = NamedTempFile::new_in(directory)?;
+                std::io::copy(&mut temporary, &mut destination)?;
+                if let Some(mode) = mode {
+                    set_file_mode(destination.path(), mode)?;
+                }
+                destination.persist(path)?;
+                Ok(())
+            }
+            Self::Special => Ok(()),
+        }
+    }
+}
+
+struct StagedCacheRead {
+    stdout: Vec<u8>,
+    stderr: Vec<u8>,
+    outputs: Vec<StagedOutput>,
+}
+
+impl StagedCacheRead {
+    fn rollback(mut backups: Vec<DestinationBackup>) -> Result<()> {
+        let mut first_error = None;
+        while let Some(backup) = backups.pop() {
+            if let Err(error) = backup.restore()
+                && first_error.is_none()
+            {
+                first_error = Some(error);
+            }
+        }
+        if let Some(error) = first_error {
+            return Err(error).context("failed to roll back cache-hit output commit");
+        }
+        Ok(())
+    }
+
+    fn commit(self, deadline: Option<std::time::Instant>) -> Result<(Vec<u8>, Vec<u8>)> {
+        let mut backups = Vec::new();
+        for output in self.outputs {
+            if deadline.is_some_and(|value| std::time::Instant::now() >= value) {
+                Self::rollback(backups)?;
+                bail!("governed cache materialization deadline expired before commit");
+            }
+            let backup = match DestinationBackup::capture(
+                output.path(),
+                output.permits_special_destination(),
+            ) {
+                Ok(backup) => backup,
+                Err(error) => {
+                    Self::rollback(backups)?;
+                    return Err(error);
+                }
+            };
+            if deadline.is_some_and(|value| std::time::Instant::now() >= value) {
+                backups.push(backup);
+                Self::rollback(backups)?;
+                bail!("governed cache materialization deadline expired before output mutation");
+            }
+            if let Err(error) = output.commit() {
+                backups.push(backup);
+                Self::rollback(backups)?;
+                return Err(error);
+            }
+            backups.push(backup);
+            if deadline.is_some_and(|value| std::time::Instant::now() >= value) {
+                Self::rollback(backups)?;
+                bail!("governed cache materialization deadline expired during commit");
+            }
+        }
+        Ok((self.stdout, self.stderr))
+    }
+}
