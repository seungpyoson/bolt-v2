+pub(crate) async fn read_bounded_child_output<R>(
+    reader: Option<R>,
+    reservation: std::sync::Arc<std::sync::atomic::AtomicU64>,
+    limit: u64,
+) -> std::io::Result<Vec<u8>>
+where
+    R: tokio::io::AsyncRead + Unpin,
+{
+    use std::sync::atomic::Ordering;
+    use tokio::io::AsyncReadExt;
+
+    let Some(mut reader) = reader else {
+        return Ok(Vec::new());
+    };
+    let mut output = Vec::new();
+    let mut chunk = [0u8; 8192];
+    loop {
+        let count = reader.read(&mut chunk).await?;
+        if count == 0 {
+            return Ok(output);
+        }
+        let count = u64::try_from(count).unwrap_or(u64::MAX);
+        let accepted = reservation.fetch_update(Ordering::AcqRel, Ordering::Acquire, |reserved| {
+            reserved.checked_add(count).filter(|total| *total <= limit)
+        });
+        if accepted.is_err() {
+            return Err(std::io::Error::other(
+                "strict child combined output exceeded its governed limit",
+            ));
+        }
+        output.extend_from_slice(&chunk[..usize::try_from(count).unwrap_or(chunk.len())]);
+    }
+}
