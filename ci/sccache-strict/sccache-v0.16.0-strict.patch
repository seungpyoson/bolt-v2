+
+fn duration_millis(duration: std::time::Duration) -> u64 {
+    u64::try_from(duration.as_millis()).expect("duration was parsed from u64 milliseconds")
+}
+
+pub fn governed_duration_from_value(name: &str, value: &str) -> Result<std::time::Duration> {
+    if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+        bail!("{name} must be a positive decimal millisecond value");
+    }
+    let millis = value
+        .parse::<u64>()
+        .with_context(|| format!("{name} must fit in an unsigned 64-bit integer"))?;
+    if millis == 0 {
+        bail!("{name} must be greater than zero");
+    }
+    Ok(std::time::Duration::from_millis(millis))
+}
+
+pub fn governed_duration_from_env(name: &str) -> Result<std::time::Duration> {
+    let value = env::var(name).with_context(|| format!("{name} is required"))?;
+    governed_duration_from_value(name, &value)
+}
+
+pub fn governed_positive_u64_from_env(name: &str) -> Result<u64> {
+    let value = env::var(name).with_context(|| format!("{name} is required"))?;
+    if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+        bail!("{name} must be a positive decimal integer");
+    }
+    let parsed = value
+        .parse::<u64>()
+        .with_context(|| format!("{name} must fit in an unsigned 64-bit integer"))?;
+    if parsed == 0 {
+        bail!("{name} must be greater than zero");
+    }
+    Ok(parsed)
+}
+
+pub fn governed_frame_length_from_env(name: &str) -> Result<u64> {
+    let length = governed_positive_u64_from_env(name)?;
+    if length > u64::from(u32::MAX) {
+        bail!("{name} must not exceed the protocol's 32-bit frame length");
+    }
+    Ok(length)
+}
