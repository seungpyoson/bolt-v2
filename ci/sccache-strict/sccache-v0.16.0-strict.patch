+fn strict_controls_from_snapshot(
+    locator: &Path,
+    snapshot: &ConsumerConfigSnapshot,
+) -> Result<StrictClientControls> {
+    let file_name = locator
+        .file_name()
+        .and_then(|name| name.to_str())
+        .context("strict bootstrap locator name is not canonical UTF-8")?;
+    let digest = file_name
+        .strip_prefix("consumer-config-v1-")
+        .and_then(|name| name.strip_suffix(".bin"))
+        .context("strict bootstrap locator name does not contain a snapshot digest")?;
+    Ok(StrictClientControls {
+        snapshot_digest: digest.to_owned(),
+        abstract_socket_name: snapshot.abstract_socket_name.clone(),
+        timeouts: snapshot.timeouts.clone(),
+        max_frame_bytes: snapshot.max_frame_bytes,
+        max_child_output_bytes: snapshot.max_child_output_bytes,
+        compiler_identities: snapshot.compilers.clone(),
+        routing: snapshot.routing.clone(),
+        storage: snapshot.storage.clone(),
+        handshake: snapshot.handshake.clone(),
+    })
+}
+
+pub fn load_strict_controls(locator: &Path) -> Result<StrictClientControls> {
+    let snapshot = load_consumer_snapshot(locator)?;
+    strict_controls_from_snapshot(locator, &snapshot)
+}
+
+#[cfg(unix)]
+pub fn classify_strict_client(
+    locator: &Path,
+    selector: &OsStr,
+    raw_environment: Vec<(OsString, OsString)>,
+) -> Result<ClassifiedStrictClient> {
+    let snapshot = load_consumer_snapshot(locator)?;
+    let selector = selector.as_bytes();
+    let compiler = snapshot
+        .compilers
+        .iter()
+        .find(|compiler| compiler.path == selector)
+        .cloned()
+        .context("compiler selector is not an exact configured absolute path")?;
+
+    let mut raw = std::collections::BTreeMap::<Vec<u8>, Vec<u8>>::new();
+    for (name, value) in raw_environment {
+        let name = name.into_vec();
+        ensure!(
+            !name.is_empty() && !name.contains(&0) && !name.contains(&b'='),
+            "raw compiler environment contains a malformed name"
+        );
+        ensure!(
+            raw.insert(name, value.into_vec()).is_none(),
+            "raw compiler environment contains a duplicate name"
+        );
+    }
+
+    let bootstrap_name = b"SCCACHE_STRICT_BOOTSTRAP".as_slice();
+    let bootstrap = raw
+        .remove(bootstrap_name)
+        .context("strict bootstrap locator is missing")?;
+    ensure!(
+        bootstrap == locator.as_os_str().as_bytes(),
+        "strict bootstrap locator changed before classification"
+    );
+    for entry in &snapshot.routing {
+        let actual = raw
+            .remove(entry.name.as_slice())
+            .with_context(|| format!("required routing entry is missing: {:?}", entry.name))?;
+        ensure!(
+            actual == entry.value,
+            "required routing entry does not match the snapshot"
+        );
+    }
+    raw.remove(b"CARGO_MAKEFLAGS".as_slice());
+
+    let mut entries = Vec::new();
+    for required in &compiler.environment {
+        let actual = raw.remove(required.name.as_slice()).with_context(|| {
+            format!(
+                "required compiler environment is missing: {:?}",
+                required.name
+            )
+        })?;
+        ensure!(
+            actual == required.value,
+            "required compiler environment does not match the snapshot"
+        );
+        entries.push(required.clone());
+    }
+    for (name, value) in raw {
+        ensure!(
+            code_owned_semantic_environment_name(strict_compiler_family(&compiler.family), &name,),
+            "raw compiler environment contains an unknown name"
+        );
+        entries.push(ConsumerEnvironmentEntry { name, value });
+    }
+    entries.sort_by(|left, right| left.name.cmp(&right.name));
+
+    let controls = strict_controls_from_snapshot(locator, &snapshot)?;
+    Ok(ClassifiedStrictClient {
+        controls,
+        compiler,
+        environment: CompilerEnvironment { entries },
+    })
+}
