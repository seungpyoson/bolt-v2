+#[cfg(target_os = "linux")]
+fn parse_linux_proc_stat(bytes: &[u8]) -> Option<(u8, i32)> {
+    let close = bytes.iter().rposition(|byte| *byte == b')')?;
+    let mut fields = bytes
+        .get(close + 1..)?
+        .split(|byte| byte.is_ascii_whitespace());
+    let state = fields.find(|field| !field.is_empty())?.first().copied()?;
+    let _parent = fields.find(|field| !field.is_empty())?;
+    let process_group = std::str::from_utf8(fields.find(|field| !field.is_empty())?)
+        .ok()?
+        .parse()
+        .ok()?;
+    Some((state, process_group))
+}
