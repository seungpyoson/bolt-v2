+fn governed_s3_config(
+    config: &Config,
+    requested: CacheMode,
+    expected: &crate::config::ConsumerStorageIdentity,
+) -> Result<crate::config::S3CacheConfig> {
+    let configs = &config.cache_configs;
+    if configs.multilevel.is_some()
+        || configs.disk.is_some()
+        || configs.azure.is_some()
+        || configs.gcs.is_some()
+        || configs.gha.is_some()
+        || configs.memcached.is_some()
+        || configs.redis.is_some()
+        || configs.webdav.is_some()
+        || configs.oss.is_some()
+        || configs.cos.is_some()
+    {
+        bail!("strict sccache permits exactly one S3 cache backend");
+    }
+
+    let mut configured = match &config.cache {
+        Some(CacheType::S3(s3)) => s3.clone(),
+        _ => bail!("strict sccache requires the governed S3 cache backend"),
+    };
+    configured.rw_mode = match requested {
+        CacheMode::ReadOnly => crate::config::CacheModeConfig::ReadOnly,
+        CacheMode::ReadWrite => crate::config::CacheModeConfig::ReadWrite,
+    };
+    let expected_config = crate::config::S3CacheConfig {
+        bucket: expected.bucket.clone(),
+        region: expected.region.clone(),
+        key_prefix: expected.key_prefix.clone(),
+        no_credentials: expected.no_credentials,
+        endpoint: expected.endpoint.clone(),
+        use_ssl: expected.use_ssl,
+        server_side_encryption: expected.server_side_encryption,
+        enable_virtual_host_style: expected.enable_virtual_host_style,
+        rw_mode: configured.rw_mode,
+    };
+    if configured != expected_config || config.basedirs != expected.basedirs {
+        bail!("effective S3 configuration does not match the consumer snapshot");
+    }
+    Ok(configured)
+}
