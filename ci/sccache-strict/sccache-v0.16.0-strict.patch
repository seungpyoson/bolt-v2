+pub(crate) fn code_owned_semantic_environment_name(
+    family: StrictCompilerFamily,
+    name: &[u8],
+) -> bool {
+    const CARGO_NAMES: &[&[u8]] = &[
+        b"CARGO",
+        b"CARGO_CRATE_NAME",
+        b"CARGO_MANIFEST_DIR",
+        b"CARGO_MANIFEST_PATH",
+        b"CARGO_PKG_AUTHORS",
+        b"CARGO_PKG_DESCRIPTION",
+        b"CARGO_PKG_HOMEPAGE",
+        b"CARGO_PKG_LICENSE",
+        b"CARGO_PKG_LICENSE_FILE",
+        b"CARGO_PKG_NAME",
+        b"CARGO_PKG_README",
+        b"CARGO_PKG_REPOSITORY",
+        b"CARGO_PKG_RUST_VERSION",
+        b"CARGO_PKG_VERSION",
+        b"CARGO_PKG_VERSION_MAJOR",
+        b"CARGO_PKG_VERSION_MINOR",
+        b"CARGO_PKG_VERSION_PATCH",
+        b"CARGO_PKG_VERSION_PRE",
+        b"CARGO_PRIMARY_PACKAGE",
+        b"CARGO_TARGET_TMPDIR",
+        b"DEBUG",
+        b"HOST",
+        b"NUM_JOBS",
+        b"OPT_LEVEL",
+        b"OUT_DIR",
+        b"PROFILE",
+        b"TARGET",
+    ];
+    (family == StrictCompilerFamily::Rust && CARGO_NAMES.contains(&name))
+        || matches!(
+            (family, name),
+            (StrictCompilerFamily::Rust, b"CARGO_ENCODED_RUSTFLAGS")
+                | (StrictCompilerFamily::Rust, b"RUSTC")
+                | (StrictCompilerFamily::Rust, b"RUSTDOC")
+        )
+}
