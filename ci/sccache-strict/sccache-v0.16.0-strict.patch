+        ))
+        .unwrap();
+        assert!(matches!(
+            bincode::deserialize::<CompileResponse>(&legacy).unwrap(),
+            CompileResponse::UnsupportedCompiler(message) if message == "legacy"
+        ));
+    }
+
+    #[test]
+    fn strict_protocol_appends_new_classifications_after_legacy_variants() {
+        let binding = StrictResponseBinding {
+            request_digest: [7; 32],
+            snapshot_digest: "snapshot".to_owned(),
+        };
+        let not_compilation =
+            bincode::serialize(&CompileResponse::NotCompilation(binding.clone())).unwrap();
+        let cannot_cache = bincode::serialize(&CompileResponse::CannotCache {
+            binding,
+            reason: "reason".to_owned(),
+        })
+        .unwrap();
+
+        assert_eq!(&not_compilation[..4], &3u32.to_le_bytes());
+        assert_eq!(&cannot_cache[..4], &4u32.to_le_bytes());
+    }
+
+    #[test]
+    fn upstream_protocol_has_no_server_identity_request() {
+        let request = bincode::serialize(&Request::GetServerIdentity).unwrap();
+        assert_eq!(&request[..4], &5u32.to_le_bytes());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn strict_request_digest_binds_every_request_field() {
+        let request = ClassifiedRequest::new(
+            OsString::from("/usr/bin/rustc"),
+            OsString::from("/work"),
+            vec![OsString::from("--crate-name"), OsString::from("demo")],
+            vec![(OsString::from("SOURCE_DATE_EPOCH"), OsString::from("1"))],
+            StrictCompilerFamily::Rust,
+            "snapshot".to_owned(),
+        );
+        assert!(request.has_valid_digest());
+
+        let mut changed = request;
+        changed.args.push(OsString::from("--emit=metadata"));
+        assert!(!changed.has_valid_digest());
+    }
+
+    #[test]
+    fn strict_environment_key_binds_names_values_and_absence() {
+        let first = strict_environment_key_component([(b"A".as_slice(), b"1".as_slice())]);
+        let changed_value = strict_environment_key_component([(b"A".as_slice(), b"2".as_slice())]);
+        let changed_name = strict_environment_key_component([(b"B".as_slice(), b"1".as_slice())]);
+        let absent = strict_environment_key_component(std::iter::empty());
+
+        assert_ne!(first, changed_value);
+        assert_ne!(first, changed_name);
+        assert_ne!(first, absent);
+    }
+
+    #[allow(dead_code)]
+    fn cover_upstream_variants() {
+        let _ = UpstreamCompileResponse::CompileStarted;
+    }
+}
