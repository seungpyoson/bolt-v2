+fn reject_forced_cache_modes(env_vars: &[(OsString, OsString)]) -> Result<()> {
+    if env_vars
+        .iter()
+        .any(|(key, _)| key == "SCCACHE_NO_CACHE" || key == "SCCACHE_RECACHE")
+    {
+        bail!("strict sccache rejects SCCACHE_NO_CACHE and SCCACHE_RECACHE");
+    }
+    Ok(())
+}
+
+async fn complete_required_cache_write(
+    cache_write: Pin<Box<dyn Future<Output = Result<CacheWriteInfo>> + Send>>,
+    timeout: Duration,
+    response: &mut CompileFinished,
+) -> Option<CacheWriteInfo> {
+    match tokio::time::timeout(timeout, cache_write).await {
+        Err(_) => {
+            error!("Required cache write timed out");
+            response.retcode = Some(-2);
+            response.stderr = b"sccache: required cache write timed out\n".to_vec();
+            None
+        }
+        Ok(Err(error)) => {
+            error!("Error executing required cache write: {error}");
+            response.retcode = Some(-2);
+            response.stderr =
+                format!("sccache: required cache write failed: {error}\n").into_bytes();
+            None
+        }
+        Ok(Ok(info)) => Some(info),
+    }
+}
