+#[cfg(all(test, unix))]
+mod strict_test {
+    use super::*;
+    use crate::mock_command::{MockChild, exit_status};
+    use crate::test::utils::{new_creator, next_command_calls};
+    use std::os::unix::net::UnixStream;
+
+    fn connection_pair() -> (ServerConnection, UnixStream) {
+        let (client, server) = UnixStream::pair().unwrap();
+        (ServerConnection::new(Box::new(client)).unwrap(), server)
+    }
+
+    #[test]
+    fn strict_cannot_cache_reason_authorizes_one_client_command() {
+        let creator = new_creator();
+        next_command_calls(&creator, |arguments| {
+            assert_eq!(arguments, [OsString::from("-")]);
+            Ok(MockChild::new(exit_status(0), "classified stdout", ""))
+        });
+        let (mut connection, _server) = connection_pair();
+        let mut runtime = new_client_runtime().unwrap();
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+
+        let result = handle_compile_response(
+            creator,
+            &mut runtime,
+            &mut connection,
+            CompileResponse::CannotCache("-".to_owned()),
+            Path::new("rustc"),
+            vec![OsString::from("-")],
+            Path::new("."),
+            &mut stdout,
+            &mut stderr,
+        )
+        .unwrap();
+
+        assert_eq!(result, 0);
+        assert!(stderr.is_empty());
+    }
+
+    #[test]
+    fn strict_not_compilation_preserves_output_arguments() {
+        let creator = new_creator();
+        let expected = vec![
+            OsString::from("probe.rs"),
+            OsString::from("--emit"),
+            OsString::from("asm"),
+            OsString::from("-o"),
+            OsString::from("probe.s"),
+        ];
+        let observed = expected.clone();
+        next_command_calls(&creator, move |arguments| {
+            assert_eq!(arguments, observed);
+            Ok(MockChild::new(exit_status(0), "", ""))
+        });
+        let (mut connection, _server) = connection_pair();
+        let mut runtime = new_client_runtime().unwrap();
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+
+        let result = handle_compile_response(
+            creator,
+            &mut runtime,
+            &mut connection,
+            CompileResponse::NotCompilation,
+            Path::new("rustc"),
+            expected,
+            Path::new("."),
+            &mut stdout,
+            &mut stderr,
+        )
+        .unwrap();
+
+        assert_eq!(result, 0);
+    }
+
+    #[test]
+    fn strict_eof_after_compile_started_never_spawns() {
+        let creator = new_creator();
+        let (mut connection, server) = connection_pair();
+        drop(server);
+        let mut runtime = new_client_runtime().unwrap();
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+
+        let result = handle_compile_response(
+            creator,
+            &mut runtime,
+            &mut connection,
+            CompileResponse::CompileStarted,
+            Path::new("rustc"),
+            Vec::new(),
+            Path::new("."),
+            &mut stdout,
+            &mut stderr,
+        );
+
+        assert!(result.is_err());
+    }
+
+    #[test]
+    fn strict_missing_server_is_an_error() {
+        let temporary = tempfile::tempdir().unwrap();
+        let address = crate::net::SocketAddr::Unix(temporary.path().join("missing.sock"));
+
+        let result = connect_required(&address, Duration::from_millis(25));
+
+        assert!(result.is_err());
+    }
+
+    #[test]
+    fn strict_timeout_values_must_be_positive_decimal_milliseconds() {
+        assert_eq!(
+            crate::config::governed_duration_from_value("SCCACHE_STRICT_IPC_TIMEOUT_MS", "25",)
+                .unwrap(),
+            Duration::from_millis(25)
+        );
+        for invalid in ["", "0", "-1", " 25", "25 ", "1.5"] {
+            assert!(
+                crate::config::governed_duration_from_value("STRICT_TIMEOUT", invalid).is_err()
+            );
+        }
+    }
+}
