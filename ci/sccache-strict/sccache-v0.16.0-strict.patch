+
+fn consumer_snapshot_max_bytes() -> Result<u64> {
+    governed_positive_u64_from_value(
+        "compiled consumer snapshot byte ceiling",
+        env!("SCCACHE_STRICT_SNAPSHOT_MAX_BYTES"),
+    )
+}
+
+fn consumer_abstract_name_max_bytes() -> Result<usize> {
+    usize::try_from(governed_positive_u64_from_value(
+        "compiled abstract socket name byte ceiling",
+        env!("SCCACHE_STRICT_ABSTRACT_NAME_MAX_BYTES"),
+    )?)
+    .context("compiled abstract socket name byte ceiling is not addressable")
+}
+
+fn validate_environment_entries(entries: &[ConsumerEnvironmentEntry], context: &str) -> Result<()> {
+    let mut names = std::collections::BTreeSet::new();
+    for entry in entries {
+        if entry.name.is_empty()
+            || entry.name.contains(&0)
+            || entry.name.contains(&b'=')
+            || !names.insert(entry.name.as_slice())
+        {
+            bail!("{context} contains a missing, malformed, or duplicate environment name");
+        }
+    }
+    Ok(())
+}
+
+fn reserved_client_control_name(name: &[u8]) -> bool {
+    matches!(
+        name,
+        b"SCCACHE_STRICT_BOOTSTRAP"
+            | b"CARGO_MAKEFLAGS"
+            | b"MAKEFLAGS"
+            | b"MFLAGS"
+            | b"RUSTC_WRAPPER"
+            | b"RUSTC_WORKSPACE_WRAPPER"
+    )
+}
+
+fn validate_consumer_snapshot(snapshot: &ConsumerConfigSnapshot) -> Result<()> {
+    ensure!(
+        snapshot.schema_version == CONSUMER_SNAPSHOT_SCHEMA_VERSION,
+        "unsupported consumer snapshot schema"
+    );
+    ensure!(
+        !snapshot.abstract_socket_name.is_empty()
+            && !snapshot.abstract_socket_name.contains(&0)
+            && snapshot.abstract_socket_name.len() <= consumer_abstract_name_max_bytes()?,
+        "consumer snapshot abstract socket name is malformed"
+    );
+    ensure!(
+        snapshot.timeouts.startup_ms > 0
+            && snapshot.timeouts.ipc_frame_ms > 0
+            && snapshot.timeouts.cache_read_ms > 0
+            && snapshot.timeouts.required_write_ms > 0,
+        "consumer snapshot timeouts must be positive"
+    );
+    for (name, millis) in [
+        ("consumer startup timeout", snapshot.timeouts.startup_ms),
+        ("consumer IPC-frame timeout", snapshot.timeouts.ipc_frame_ms),
+        (
+            "consumer cache-read timeout",
+            snapshot.timeouts.cache_read_ms,
+        ),
+        (
+            "consumer required-write timeout",
+            snapshot.timeouts.required_write_ms,
+        ),
+    ] {
+        governed_duration_from_value(name, &millis.to_string())?;
+    }
+    ensure!(
+        snapshot.max_frame_bytes > 0,
+        "consumer snapshot frame limit must be positive"
+    );
+    ensure!(
+        !snapshot.compilers.is_empty(),
+        "consumer snapshot compiler set is empty"
+    );
+    let mut compiler_paths = std::collections::BTreeSet::new();
+    for compiler in &snapshot.compilers {
+        ensure!(
+            compiler.path.starts_with(b"/") && !compiler.path.contains(&0),
+            "consumer snapshot compiler path must be absolute and canonical"
+        );
+        ensure!(
+            compiler_paths.insert(compiler.path.as_slice()),
+            "consumer snapshot compiler path is duplicated"
+        );
+        validate_environment_entries(&compiler.environment, "consumer compiler environment")?;
+        ensure!(
+            compiler
+                .environment
+                .iter()
+                .all(|entry| !reserved_client_control_name(&entry.name)),
+            "consumer compiler environment contains a reserved control name"
+        );
+    }
+    validate_environment_entries(&snapshot.routing, "consumer routing environment")?;
+    ensure!(
+        snapshot.routing.iter().all(|entry| matches!(
+            entry.name.as_slice(),
+            b"RUSTC_WRAPPER" | b"RUSTC_WORKSPACE_WRAPPER"
+        )),
+        "consumer routing environment contains a non-routing or reserved control name"
+    );
+    ensure!(
+        snapshot.handshake.protocol_version > 0,
+        "consumer handshake version must be positive"
+    );
+    ensure!(
+        !snapshot.handshake.derivative_identity.is_empty(),
+        "consumer derivative identity is empty"
+    );
+    ensure!(
+        matches!(
+            snapshot.handshake.cache_mode.as_str(),
+            "READ_ONLY" | "READ_WRITE"
+        ),
+        "consumer cache mode is invalid"
+    );
+    Ok(())
+}
+
+fn canonical_consumer_snapshot(snapshot: &ConsumerConfigSnapshot) -> Result<Vec<u8>> {
+    validate_consumer_snapshot(snapshot)?;
+    let bytes = bincode::serialize(snapshot).context("failed to encode consumer snapshot")?;
+    ensure!(
+        u64::try_from(bytes.len()).unwrap_or(u64::MAX) <= consumer_snapshot_max_bytes()?,
+        "consumer snapshot exceeds the compiled byte ceiling"
+    );
+    Ok(bytes)
+}
+
+fn consumer_snapshot_name(bytes: &[u8]) -> String {
+    format!(
+        "consumer-config-v{}-{}.bin",
+        CONSUMER_SNAPSHOT_SCHEMA_VERSION,
+        blake3::hash(bytes).to_hex()
+    )
+}
+
+pub fn materialize_consumer_snapshot(
+    snapshot: &ConsumerConfigSnapshot,
+    directory: &Path,
+) -> Result<PathBuf> {
+    let bytes = canonical_consumer_snapshot(snapshot)?;
+    let locator = directory.join(consumer_snapshot_name(&bytes));
+    let mut options = std::fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    options
+        .mode(0o600)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW);
+    let mut file = options.open(&locator).with_context(|| {
+        format!(
+            "consumer snapshot destination already exists or is unsafe: {}",
+            locator.display()
+        )
+    })?;
+    file.write_all(&bytes)
+        .context("failed to write consumer snapshot")?;
+    file.sync_all()
+        .context("failed to sync consumer snapshot")?;
+    Ok(locator)
+}
+
+fn toml_environment_entries(
+    entries: std::collections::BTreeMap<String, String>,
+) -> Vec<ConsumerEnvironmentEntry> {
+    entries
+        .into_iter()
+        .map(|(name, value)| ConsumerEnvironmentEntry {
+            name: name.into_bytes(),
+            value: value.into_bytes(),
+        })
+        .collect()
+}
+
+pub fn materialize_consumer_snapshot_from_toml(
+    document: &str,
+    job_identity: &[u8],
+    directory: &Path,
+) -> Result<PathBuf> {
+    ensure!(
+        !job_identity.is_empty()
+            && job_identity
+                .iter()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.')),
+        "consumer job identity is malformed"
+    );
+    let input: ConsumerTomlDocument =
+        toml::from_str(document).context("failed to parse consumer snapshot TOML")?;
+    ensure!(
+        input.schema_version == CONSUMER_SNAPSHOT_SCHEMA_VERSION,
+        "consumer TOML schema does not match the snapshot schema"
+    );
+    let placeholder = "{job_identity}";
+    ensure!(
+        input
+            .consumer
+            .abstract_socket_template
+            .matches(placeholder)
+            .count()
+            == 1,
+        "consumer abstract socket template must contain one job identity placeholder"
+    );
+    let job_identity = std::str::from_utf8(job_identity)
+        .context("consumer job identity is not canonical UTF-8")?;
+    let abstract_socket_name = input
+        .consumer
+        .abstract_socket_template
+        .replace(placeholder, job_identity)
+        .into_bytes();
+    let snapshot = ConsumerConfigSnapshot {
+        schema_version: input.schema_version,
+        abstract_socket_name,
+        timeouts: ConsumerTimeouts {
+            startup_ms: input.consumer.startup_timeout_ms,
+            ipc_frame_ms: input.consumer.ipc_frame_timeout_ms,
+            cache_read_ms: input.consumer.cache_read_timeout_ms,
+            required_write_ms: input.consumer.required_write_timeout_ms,
+        },
+        max_frame_bytes: input.consumer.max_frame_bytes,
+        compilers: input
+            .consumer
+            .compilers
+            .into_iter()
+            .map(|compiler| ConsumerCompiler {
+                path: compiler.path.into_bytes(),
+                family: compiler.family,
+                environment: toml_environment_entries(compiler.environment),
+            })
+            .collect(),
+        routing: toml_environment_entries(input.consumer.routing),
+        handshake: ConsumerHandshakePolicy {
+            protocol_version: CONSUMER_SNAPSHOT_SCHEMA_VERSION,
+            derivative_identity: env!("SCCACHE_STRICT_DERIVATIVE_ID").to_owned(),
+            cache_mode: input.consumer.cache_mode,
+        },
+    };
+    materialize_consumer_snapshot(&snapshot, directory)
+}
+
+pub fn materialize_consumer_snapshot_from_path(
+    config_path: &Path,
+    job_identity: &[u8],
+    directory: &Path,
+) -> Result<PathBuf> {
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    options.custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW);
+    let mut file = options.open(config_path).with_context(|| {
+        format!(
+            "consumer config is not a bounded no-follow regular file: {}",
+            config_path.display()
+        )
+    })?;
+    let metadata = file
+        .metadata()
+        .context("failed to inspect consumer config no-follow regular file")?;
+    let max_bytes = consumer_snapshot_max_bytes()?;
+    ensure!(
+        metadata.file_type().is_file() && metadata.len() > 0 && metadata.len() <= max_bytes,
+        "consumer config is not a bounded no-follow regular file"
+    );
+    let mut bytes = Vec::with_capacity(
+        usize::try_from(metadata.len()).context("consumer config size is not addressable")?,
+    );
+    std::io::Read::by_ref(&mut file)
+        .take(max_bytes + 1)
+        .read_to_end(&mut bytes)
+        .context("failed to read consumer config")?;
+    ensure!(
+        u64::try_from(bytes.len()).unwrap_or(u64::MAX) <= max_bytes,
+        "consumer config is oversized"
+    );
+    let document = std::str::from_utf8(&bytes).context("consumer config is not canonical UTF-8")?;
+    materialize_consumer_snapshot_from_toml(document, job_identity, directory)
+}
+
+pub fn load_consumer_snapshot(locator: &Path) -> Result<ConsumerConfigSnapshot> {
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    options.custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW);
+    let mut file = options.open(locator).with_context(|| {
+        format!(
+            "consumer snapshot locator is not a bounded no-follow regular file: {}",
+            locator.display()
+        )
+    })?;
+    let metadata = file
+        .metadata()
+        .context("failed to inspect consumer snapshot no-follow regular file")?;
+    ensure!(
+        metadata.file_type().is_file(),
+        "consumer snapshot locator is not a no-follow regular file"
+    );
+    let max_bytes = consumer_snapshot_max_bytes()?;
+    ensure!(
+        metadata.len() > 0 && metadata.len() <= max_bytes,
+        "consumer snapshot is empty or oversized"
+    );
+    let mut bytes = Vec::with_capacity(
+        usize::try_from(metadata.len()).context("snapshot size is not addressable")?,
+    );
+    std::io::Read::by_ref(&mut file)
+        .take(max_bytes + 1)
+        .read_to_end(&mut bytes)
+        .context("failed to read consumer snapshot")?;
+    ensure!(
+        u64::try_from(bytes.len()).unwrap_or(u64::MAX) <= max_bytes,
+        "consumer snapshot is oversized"
+    );
+    let expected_name = consumer_snapshot_name(&bytes);
+    ensure!(
+        locator.file_name().and_then(|name| name.to_str()) == Some(expected_name.as_str()),
+        "consumer snapshot content digest does not match its locator name"
+    );
+    let snapshot: ConsumerConfigSnapshot =
+        bincode::deserialize(&bytes).context("failed to decode consumer snapshot")?;
+    ensure!(
+        canonical_consumer_snapshot(&snapshot)? == bytes,
+        "consumer snapshot encoding is not canonical"
+    );
+    Ok(snapshot)
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StrictTimeouts {
+    pub startup: std::time::Duration,
+    pub ipc: std::time::Duration,
+    pub cache_read: std::time::Duration,
+    pub cache_write: std::time::Duration,
+}
+
+impl StrictTimeouts {
+    pub fn from_env() -> Result<Self> {
+        Ok(Self {
+            startup: governed_duration_from_env("SCCACHE_STRICT_STARTUP_TIMEOUT_MS")?,
+            ipc: governed_duration_from_env("SCCACHE_STRICT_IPC_TIMEOUT_MS")?,
+            cache_read: governed_duration_from_env("SCCACHE_STRICT_CACHE_READ_TIMEOUT_MS")?,
+            cache_write: governed_duration_from_env("SCCACHE_STRICT_CACHE_WRITE_TIMEOUT_MS")?,
+        })
+    }
+
+    #[cfg(test)]
+    pub fn for_tests() -> Self {
+        let timeout = std::time::Duration::from_secs(30);
+        Self {
+            startup: timeout,
+            ipc: timeout,
+            cache_read: timeout,
+            cache_write: timeout,
+        }
+    }
+}
+
+fn duration_millis(duration: std::time::Duration) -> u64 {
+    u64::try_from(duration.as_millis()).expect("duration was parsed from u64 milliseconds")
