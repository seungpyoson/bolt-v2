+#[cfg(unix)]
+fn remove_owned_unix_socket(ownership: UnixSocketOwnership) -> io::Result<()> {
+    match unix_socket_identity(&ownership.path) {
+        Ok(current) if current == ownership.identity => fs::remove_file(&ownership.path),
+        Ok(_) | Err(_) => Ok(()),
+    }
