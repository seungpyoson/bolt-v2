set shell := ["bash", "-euo", "pipefail", "-c"]

# Native build target = the local dev/research host (the stated run environment).
# `build` is a NATIVE release build — the backtester runs on a dev/research
# machine and never cross-compiles to the EC2 trading target. Changes in one
# place if a research box is chosen.
target := "aarch64-apple-darwin"

clippy:
    cargo clippy --locked -- -D warnings

test *args:
    cargo nextest run --locked {{args}}

build:
    cargo build --release --target {{target}} --locked
