# Single source of truth for bolt-v2 install paths. Consumed by deploy/install.sh
# (sourced) and scripts/render_install_unit.py (renders the systemd unit). The
# committed deploy/systemd/bolt-v2.service is GENERATED from this + the .in template
# via `just generate-unit`; never edit the unit by hand.
BOLT_HOME=/srv/bolt-v2
BOLT_INSTALL_ROOT=/opt/bolt-v2
LIVE_ENV_DIR=/etc/bolt-v2
# Service identity. Single-sourced here so the generated systemd unit (User=/Group=)
# and install.sh (provisioning + 0750 config-bundle ownership) cannot diverge: the
# committed unit is baked at generate-time, so a deploy-time env override could never
# reach it. Both surfaces read these.
BOLT_USER=bolt
BOLT_GROUP=bolt
# Absolute util-linux mountpoint tool path used by the unit ExecStartPre gate and install.sh pre-flight mount check.
MOUNTPOINT_BIN=/usr/bin/mountpoint
