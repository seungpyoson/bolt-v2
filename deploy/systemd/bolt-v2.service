[Unit]
Description=bolt-v2 live node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bolt
Group=bolt
WorkingDirectory=/srv/bolt-v2
TimeoutStartSec=180
EnvironmentFile=/etc/bolt-v2/live.env
ExecStartPre=/usr/bin/mountpoint -q /srv/bolt-v2
ExecStart=/opt/bolt-v2/bolt-v2 ops launch --profile "${BOLT_LIVE_PROFILE}" --config-root /opt/bolt-v2/config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
