[Unit]
Description=bolt-v2 live node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bolt
Group=bolt
WorkingDirectory=/srv/bolt-v2
TimeoutStartSec=180
ExecStartPre=/usr/bin/mountpoint -q /srv/bolt-v2
ExecStartPre=/opt/bolt-v2/bolt-v2 ops prestart-check --config /opt/bolt-v2/config/live.toml
ExecStartPre=/opt/bolt-v2/bolt-v2 ops reference-live-probe --config /opt/bolt-v2/config/live.toml
ExecStart=/opt/bolt-v2/bolt-v2 run --config /opt/bolt-v2/config/live.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
