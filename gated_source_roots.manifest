# Gated source roots — THE single owner of the Bolt-v3 abort-plan source-fence
# and strategy-policy file set. build.rs generates the GATED_SOURCE_ROOTS
# constant from this file; src/source_canonicalization.rs includes the
# generated constant. The manifest and build.rs are the enforcing pair.
#
# Format: lines starting with '#' are comments; blank lines are ignored;
# '[key]' starts a source set whose key must match the STRATEGY_KEY /
# SUBMIT_ADMISSION_KEY / OUTCOME_GROUP_KEY / MAKER_KEY constants in
# src/source_canonicalization.rs; every other line is a repo-relative root — a
# single .rs file OR a directory of .rs files. Edit this file (and nothing else)
# to change which sources are gated.

[strategy]
src/strategies/binary_oracle_edge_taker
# The shared policy is the only approved Bolt-v3 strategy-originated NT
# submit/cancel mutation boundary.
src/bolt_v3_order_execution.rs
src/bolt_v3_book_sizing.rs
src/bolt_v3_binary_outcome_edge.rs
src/bolt_v3_executable_cost.rs
src/bolt_v3_sizing.rs
src/bolt_v3_taker_updown_signal.rs
[submit_admission]
src/bolt_v3_submit_admission.rs
src/bolt_v3_settlement_booking.rs
# Reference-price health owns live-node/msgbus observation mechanics, so it is
# integrity-gated with the runtime coordinator rather than strategy policy.
src/bolt_v3_reference_price_health.rs
# The live-node coordinator and its submodules are gated with submit/admission
# sources but must stay outside [strategy], because they own runtime wiring that
# strategy-source policy intentionally forbids.
src/bolt_v3_live_node.rs
src/bolt_v3_live_node

[outcome_group]
src/bolt_v3_atomic_io.rs
src/bolt_v3_outcome_groups.rs
src/bolt_v3_outcome_group_proofs.rs
src/bolt_v3_outcome_group_sources.rs
src/bolt_v3_outcome_group_polymarket.rs
src/bolt_v3_outcome_group_hyperliquid.rs
src/bolt_v3_outcome_group_scanner.rs
src/bolt_v3_basket_admission.rs
src/bolt_v3_market_families/outcome_group.rs

[maker]
src/bolt_v3_maker_go_live_gate.rs
src/bolt_v3_maker_market_selection.rs
src/strategies/binary_oracle_maker
