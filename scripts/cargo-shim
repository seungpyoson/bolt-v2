#!/usr/bin/env python3
"""Cargo PATH shim that enforces repo-local Rust verification policy."""

from __future__ import annotations

import os
import shutil
import sys
from ast import literal_eval
from pathlib import Path

import rust_verification

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - supported runtime has tomllib
    tomllib = None


VALUE_TAKING_GLOBAL_FLAGS = {
    "--color",
    "--config",
    "--jobs",
    "--manifest-path",
    "--message-format",
    "--profile",
    "--target",
    "--target-dir",
    "-C",
    "-j",
    "-Z",
}


def nearest_policy_root(cwd: Path) -> Path | None:
    try:
        current = cwd.resolve(strict=False)
    except OSError:
        current = cwd.absolute()
    for candidate in (current, *current.parents):
        if (candidate / "ci" / "rust-verification.toml").is_file():
            return candidate
    return None


def cargo_subcommand(args: list[str]) -> str | None:
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            i += 1
            continue
        if arg.startswith("+"):
            i += 1
            continue
        if arg in VALUE_TAKING_GLOBAL_FLAGS:
            i += 2
            continue
        if any(arg.startswith(f"{flag}=") for flag in VALUE_TAKING_GLOBAL_FLAGS if flag.startswith("--")):
            i += 1
            continue
        if arg.startswith("-"):
            i += 1
            continue
        return arg
    return None


def load_policy(policy_path: Path) -> dict[str, object] | None:
    if not policy_path.exists():
        return None
    if tomllib is None:
        policy = load_policy_fallback(policy_path)
        if policy is None:
            raise ValueError("local_compile_policy table is required")
        return policy
    try:
        with policy_path.open("rb") as f:
            data = tomllib.load(f)
    except tomllib.TOMLDecodeError as exc:
        raise ValueError(str(exc)) from exc
    policy = data.get("local_compile_policy")
    if policy is None:
        raise ValueError("local_compile_policy table is required")
    if not isinstance(policy, dict):
        raise ValueError("local_compile_policy must be a table")
    return policy


def load_target_namespace(policy_path: Path) -> str:
    if tomllib is None:
        namespace = load_target_namespace_fallback(policy_path)
        if namespace is None:
            raise ValueError("target_namespace is required")
        return namespace
    try:
        with policy_path.open("rb") as f:
            data = tomllib.load(f)
    except tomllib.TOMLDecodeError as exc:
        raise ValueError(str(exc)) from exc
    namespace = data.get("target_namespace")
    if not isinstance(namespace, str) or not namespace:
        raise ValueError("target_namespace is required")
    return namespace


def load_target_namespace_fallback(policy_path: Path) -> str | None:
    for raw_line in policy_path.read_text(encoding="utf-8").splitlines():
        line = strip_toml_comment(raw_line).strip()
        if not line or "=" not in line:
            continue
        key, raw_value = line.split("=", 1)
        if key.strip() != "target_namespace":
            continue
        try:
            value = literal_eval(raw_value.strip())
        except (ValueError, SyntaxError) as exc:
            raise ValueError("target_namespace must be a quoted string") from exc
        if not isinstance(value, str) or not value:
            raise ValueError("target_namespace is required")
        return value
    return None


def strip_toml_comment(raw_line: str) -> str:
    quote: str | None = None
    escaped = False
    for index, char in enumerate(raw_line):
        if escaped:
            escaped = False
            continue
        if quote is not None:
            if quote == '"' and char == "\\":
                escaped = True
                continue
            if char == quote:
                quote = None
            continue
        if char in {'"', "'"}:
            quote = char
            continue
        if char == "#":
            return raw_line[:index]
    return raw_line


def load_policy_fallback(policy_path: Path) -> dict[str, object] | None:
    in_section = False
    saw_policy_section = False
    policy: dict[str, object] = {}
    current_key: str | None = None
    current_value_parts: list[str] = []
    for raw_line in policy_path.read_text(encoding="utf-8").splitlines():
        line = strip_toml_comment(raw_line).strip()
        if not line:
            continue
        if current_key is not None:
            current_value_parts.append(line)
            value = " ".join(current_value_parts).strip()
            if not value.startswith("[") or value.endswith("]"):
                policy[current_key] = parse_fallback_value(value)
                current_key = None
                current_value_parts = []
            continue
        if line.startswith("["):
            if not line.endswith("]"):
                raise ValueError(f"invalid TOML table header: {raw_line.strip()}")
            in_section = line == "[local_compile_policy]"
            saw_policy_section = saw_policy_section or in_section
            continue
        if not in_section:
            continue
        if current_key is None:
            if "=" not in line:
                raise ValueError(f"invalid policy line: {raw_line.strip()}")
            key, raw_value = line.split("=", 1)
            current_key = key.strip()
            current_value_parts = [raw_value.strip()]

        value = " ".join(current_value_parts).strip()
        if not value.startswith("[") or value.endswith("]"):
            policy[current_key] = parse_fallback_value(value)
            current_key = None
            current_value_parts = []
    if current_key is not None:
        policy[current_key] = parse_fallback_value(" ".join(current_value_parts).strip())
    if saw_policy_section:
        return policy
    return None


def parse_fallback_value(raw_value: str) -> object:
    if raw_value == "true":
        return True
    if raw_value == "false":
        return False
    if raw_value.startswith('"') or raw_value.startswith("'") or raw_value.startswith("["):
        try:
            return literal_eval(raw_value)
        except (SyntaxError, ValueError) as exc:
            raise ValueError(f"invalid policy value: {raw_value}") from exc
    raise ValueError(f"unsupported policy value: {raw_value}")


def policy_refused_commands(policy: dict[str, object]) -> set[str]:
    raw = policy.get("refused_cargo_subcommands")
    if not isinstance(raw, list) or not raw or not all(isinstance(item, str) and item for item in raw):
        raise ValueError("refused_cargo_subcommands must be a non-empty string list")
    return set(raw)


def env_name(policy: dict[str, object], key: str) -> str | None:
    value = policy.get(key)
    return value if isinstance(value, str) and value else None


def bypass_enabled(policy: dict[str, object]) -> bool:
    break_glass = env_name(policy, "break_glass_env")
    if break_glass and os.environ.get(break_glass) == "1":
        return True
    ci_env = env_name(policy, "allowed_ci_env")
    return bool(ci_env and os.environ.get(ci_env) == "true")


def refusal_message(policy: dict[str, object]) -> str:
    break_glass = env_name(policy, "break_glass_env")
    if break_glass:
        break_glass_line = f"Human operator break-glass: {break_glass}=1 cargo <cmd>"
    else:
        break_glass_line = "Human operator break-glass: not configured"
    return "\n".join(
        [
            "Local compile-heavy Rust is disabled for agent sessions in this repo.",
            "Use this repo's non-compile local checks, then commit/push and use its remote verification workflow.",
            break_glass_line,
            "Policy: ci/rust-verification.toml [local_compile_policy]",
            "",
        ]
    )


def resolve_real_cargo() -> Path | None:
    override = os.environ.get("BOLT_CARGO_SHIM_REAL_CARGO")
    if override:
        return Path(override)

    shim_dir = Path(__file__).resolve().parent
    try:
        default = Path.home() / ".cargo" / "bin" / "cargo"
        if default.exists():
            try:
                if default.resolve() != Path(__file__).resolve():
                    return default
            except OSError:
                return default
    except (RuntimeError, KeyError):
        pass

    path = os.environ.get("PATH", "")
    filtered = []
    for entry in path.split(os.pathsep):
        if not entry:
            continue
        try:
            if Path(entry).resolve() == shim_dir:
                continue
        except OSError:
            pass
        filtered.append(entry)
    found = shutil.which("cargo", path=os.pathsep.join(filtered))
    return Path(found) if found else None


def managed_exec_env(root: Path, policy_path: Path) -> dict[str, str]:
    if tomllib is not None:
        try:
            with policy_path.open("rb") as f:
                data = tomllib.load(f)
            if isinstance(data.get("target_namespace"), str):
                return rust_verification.managed_env(root, data)
        except (OSError, tomllib.TOMLDecodeError):
            pass
    namespace = load_target_namespace(policy_path)
    return rust_verification.managed_env(root, {"target_namespace": namespace})


def exec_real_cargo(args: list[str], *, root: Path | None = None, policy_path: Path | None = None) -> int:
    real = resolve_real_cargo()
    if real is None:
        print("cargo shim: cannot find real cargo executable", file=sys.stderr)
        return 127
    if real.resolve() == Path(__file__).resolve():
        print("cargo shim: real cargo resolved to shim; refusing recursion", file=sys.stderr)
        return 127
    if root is not None and policy_path is not None:
        try:
            env = managed_exec_env(root, policy_path)
        except (ValueError, OSError) as exc:
            print(
                f"cargo shim: cannot prepare managed Cargo environment from ci/rust-verification.toml: {exc}",
                file=sys.stderr,
            )
            return 101
        os.environ.clear()
        os.environ.update(env)
    try:
        os.execv(str(real), [str(real), *args])
    except OSError as exc:
        print(f"cargo shim: cannot exec real cargo at {real}: {exc}", file=sys.stderr)
        return 127


def main(argv: list[str]) -> int:
    root = nearest_policy_root(Path.cwd())
    if root is None:
        return exec_real_cargo(argv)

    policy_path = root / "ci" / "rust-verification.toml"
    try:
        policy = load_policy(policy_path)
    except (ValueError, OSError) as exc:
        print(
            f"cargo shim: cannot load or parse ci/rust-verification.toml [local_compile_policy]: {exc}",
            file=sys.stderr,
        )
        return 101
    if policy is None:
        return exec_real_cargo(argv)
    if "enabled" not in policy:
        print(
            "cargo shim: ci/rust-verification.toml [local_compile_policy].enabled is missing; "
            "local cargo guard disabled",
            file=sys.stderr,
        )
        return exec_real_cargo(argv)
    if policy.get("enabled") is not True:
        return exec_real_cargo(argv)

    try:
        refused = policy_refused_commands(policy)
    except ValueError as exc:
        print(f"cargo shim: invalid ci/rust-verification.toml [local_compile_policy]: {exc}", file=sys.stderr)
        return 101

    command = cargo_subcommand(argv)
    if command in refused and not bypass_enabled(policy):
        print(refusal_message(policy), file=sys.stderr, end="")
        return 101

    return exec_real_cargo(argv, root=root, policy_path=policy_path)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
