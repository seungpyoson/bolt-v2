#!/usr/bin/env python3
"""Cargo PATH shim that enforces repo-local Rust verification policy."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - supported runtime has tomllib
    tomllib = None


# BEGIN embedded scripts/minimal_toml.py
import json
import pathlib
import re
from typing import Any


SAFE_TOML_IDENTIFIER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


class MinimalTomlError(ValueError):
    pass


def _display_path(path: pathlib.Path, display_path: pathlib.Path | str | None) -> str:
    return str(display_path if display_path is not None else path)


def _fail(error_cls: type[Exception], message: str) -> None:
    raise error_cls(message)


def check_size(
    path: pathlib.Path,
    *,
    max_bytes: int | None = None,
    display_path: pathlib.Path | str | None = None,
    error_cls: type[Exception] = MinimalTomlError,
) -> None:
    if max_bytes is None:
        return
    size = path.stat().st_size
    if size > max_bytes:
        shown = _display_path(path, display_path)
        _fail(error_cls, f"{shown} exceeds maximum size of {max_bytes} bytes")


def load(
    path: pathlib.Path,
    *,
    max_bytes: int | None = None,
    display_path: pathlib.Path | str | None = None,
    error_cls: type[Exception] = MinimalTomlError,
) -> dict[str, Any]:
    check_size(path, max_bytes=max_bytes, display_path=display_path, error_cls=error_cls)
    shown = _display_path(path, display_path)
    data: dict[str, Any] = {}
    current: dict[str, Any] = data
    with path.open("r", encoding="utf-8") as handle:
        lines = enumerate(handle, start=1)
        for lineno, raw_line in lines:
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("["):
                if not line.endswith("]"):
                    _fail(error_cls, f"{shown}:{lineno}: invalid TOML table header")
                current = data
                for part in line[1:-1].split("."):
                    if not part or not SAFE_TOML_IDENTIFIER_RE.match(part):
                        _fail(error_cls, f"{shown}:{lineno}: unsupported table name")
                    child = current.setdefault(part, {})
                    if not isinstance(child, dict):
                        _fail(error_cls, f"{shown}:{lineno}: table conflicts with scalar")
                    current = child
                continue
            key, sep, value_text = line.partition("=")
            if not sep:
                _fail(error_cls, f"{shown}:{lineno}: expected key = value")
            key = key.strip()
            if key.startswith('"') and key.endswith('"'):
                try:
                    parsed_key = json.loads(key)
                except json.JSONDecodeError as exc:
                    raise error_cls(f"{shown}:{lineno}: invalid key") from exc
                if not isinstance(parsed_key, str) or not parsed_key:
                    _fail(error_cls, f"{shown}:{lineno}: invalid key")
                key = parsed_key
            elif not SAFE_TOML_IDENTIFIER_RE.match(key):
                _fail(error_cls, f"{shown}:{lineno}: unsupported key")
            value_text = value_text.strip()
            if value_text.startswith('"') and value_text.endswith('"'):
                try:
                    value: Any = json.loads(value_text)
                except json.JSONDecodeError as exc:
                    raise error_cls(f"{shown}:{lineno}: invalid string") from exc
            elif value_text.startswith("[") and value_text.endswith("]"):
                try:
                    value = json.loads(value_text)
                except json.JSONDecodeError as exc:
                    raise error_cls(f"{shown}:{lineno}: invalid array") from exc
                if not all(isinstance(item, str) for item in value):
                    _fail(error_cls, f"{shown}:{lineno}: unsupported array")
            elif value_text == "[":
                value = []
                for array_lineno, raw_array_line in lines:
                    item_text = raw_array_line.strip()
                    if not item_text or item_text.startswith("#"):
                        continue
                    if item_text == "]":
                        break
                    if item_text.endswith(","):
                        item_text = item_text[:-1].strip()
                    if not item_text.startswith('"') or not item_text.endswith('"'):
                        _fail(error_cls, f"{shown}:{array_lineno}: unsupported array")
                    try:
                        item = json.loads(item_text)
                    except json.JSONDecodeError as exc:
                        raise error_cls(f"{shown}:{array_lineno}: invalid string") from exc
                    if not isinstance(item, str):
                        _fail(error_cls, f"{shown}:{array_lineno}: unsupported array")
                    value.append(item)
                else:
                    _fail(error_cls, f"{shown}:{lineno}: unterminated array")
            elif value_text in ("true", "false"):
                value = value_text == "true"
            elif value_text.isascii() and value_text.isdigit():
                value = int(value_text)
            else:
                _fail(error_cls, f"{shown}:{lineno}: unsupported value")
            current[key] = value
    return data
# END embedded scripts/minimal_toml.py


VALUE_TAKING_GLOBAL_FLAGS = {
    "--color",
    "--config",
    "--jobs",
    "--manifest-path",
    "--message-format",
    "--profile",
    "--target",
    "--target-dir",
    "-C",
    "-j",
    "-Z",
}


def nearest_policy_root(cwd: Path) -> Path | None:
    try:
        current = cwd.resolve(strict=False)
    except OSError:
        current = cwd.absolute()
    for candidate in (current, *current.parents):
        if (candidate / "ci" / "rust-verification.toml").is_file():
            return candidate
    return None


def cargo_subcommand(args: list[str]) -> str | None:
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            i += 1
            continue
        if arg.startswith("+"):
            i += 1
            continue
        if arg in VALUE_TAKING_GLOBAL_FLAGS:
            i += 2
            continue
        if any(arg.startswith(f"{flag}=") for flag in VALUE_TAKING_GLOBAL_FLAGS if flag.startswith("--")):
            i += 1
            continue
        if arg.startswith("-"):
            i += 1
            continue
        return arg
    return None


def load_policy(policy_path: Path) -> dict[str, object] | None:
    if not policy_path.exists():
        return None
    if tomllib is None:
        data = load(policy_path)
        policy = data.get("local_compile_policy")
        if policy is None:
            raise ValueError("local_compile_policy table is required")
        if not isinstance(policy, dict):
            raise ValueError("local_compile_policy must be a table")
        return policy
    try:
        with policy_path.open("rb") as f:
            data = tomllib.load(f)
    except tomllib.TOMLDecodeError as exc:
        raise ValueError(str(exc)) from exc
    policy = data.get("local_compile_policy")
    if policy is None:
        raise ValueError("local_compile_policy table is required")
    if not isinstance(policy, dict):
        raise ValueError("local_compile_policy must be a table")
    return policy


def load_target_namespace(policy_path: Path) -> str:
    if tomllib is None:
        namespace = load(policy_path).get("target_namespace")
    else:
        try:
            with policy_path.open("rb") as f:
                data = tomllib.load(f)
        except tomllib.TOMLDecodeError as exc:
            raise ValueError(str(exc)) from exc
        namespace = data.get("target_namespace")
    if not isinstance(namespace, str) or not namespace:
        raise ValueError("target_namespace is required")
    return namespace


def rust_verification_root_base() -> Path:
    raw = os.environ.get("RUST_VERIFICATION_ROOT_BASE")
    if raw:
        return Path(raw).expanduser()
    return Path.home() / ".cache" / "rust-verification"


def managed_target_dir(root: Path) -> Path:
    return rust_verification_root_base() / load_target_namespace(root / "ci" / "rust-verification.toml") / "target"


def policy_refused_commands(policy: dict[str, object]) -> set[str]:
    raw = policy.get("refused_cargo_subcommands")
    if not isinstance(raw, list) or not raw or not all(isinstance(item, str) and item for item in raw):
        raise ValueError("refused_cargo_subcommands must be a non-empty string list")
    return set(raw)


def env_name(policy: dict[str, object], key: str) -> str | None:
    value = policy.get(key)
    return value if isinstance(value, str) and value else None


def bypass_enabled(policy: dict[str, object]) -> bool:
    break_glass = env_name(policy, "break_glass_env")
    if break_glass and os.environ.get(break_glass) == "1":
        return True
    ci_env = env_name(policy, "allowed_ci_env")
    return bool(ci_env and os.environ.get(ci_env) == "true")


def refusal_message(policy: dict[str, object]) -> str:
    break_glass = env_name(policy, "break_glass_env")
    if break_glass:
        break_glass_line = f"Human operator break-glass: {break_glass}=1 cargo <cmd>"
    else:
        break_glass_line = "Human operator break-glass: not configured"
    return "\n".join(
        [
            "Local compile-heavy Rust is disabled for agent sessions in this repo.",
            "Use this repo's non-compile local checks, then commit/push and use its remote verification workflow.",
            break_glass_line,
            "Policy: ci/rust-verification.toml [local_compile_policy]",
            "",
        ]
    )


def resolve_real_cargo() -> Path | None:
    override = os.environ.get("BOLT_CARGO_SHIM_REAL_CARGO")
    if override:
        return Path(override)

    shim_dir = Path(__file__).resolve().parent
    try:
        default = Path.home() / ".cargo" / "bin" / "cargo"
        if default.exists():
            try:
                if default.resolve() != Path(__file__).resolve():
                    return default
            except OSError:
                return default
    except (RuntimeError, KeyError):
        pass

    path = os.environ.get("PATH", "")
    filtered = []
    for entry in path.split(os.pathsep):
        if not entry:
            continue
        try:
            if Path(entry).resolve() == shim_dir:
                continue
        except OSError:
            pass
        filtered.append(entry)
    found = shutil.which("cargo", path=os.pathsep.join(filtered))
    return Path(found) if found else None


def exec_real_cargo(args: list[str], *, root: Path | None = None, policy_path: Path | None = None) -> int:
    real = resolve_real_cargo()
    if real is None:
        print("cargo shim: cannot find real cargo executable", file=sys.stderr)
        return 127
    if real.resolve() == Path(__file__).resolve():
        print("cargo shim: real cargo resolved to shim; refusing recursion", file=sys.stderr)
        return 127
    if root is not None and policy_path is not None:
        try:
            target_dir = managed_target_dir(root)
        except (ValueError, OSError) as exc:
            print(
                f"cargo shim: cannot prepare managed Cargo target dir from ci/rust-verification.toml: {exc}",
                file=sys.stderr,
            )
            return 101
        existing_target_dir = os.environ.get("CARGO_TARGET_DIR")
        if existing_target_dir is not None and existing_target_dir != str(target_dir):
            print(
                f"cargo shim: overriding CARGO_TARGET_DIR with managed target dir: {existing_target_dir} -> {target_dir}",
                file=sys.stderr,
            )
        os.environ["CARGO_TARGET_DIR"] = str(target_dir)
    try:
        os.execv(str(real), [str(real), *args])
    except OSError as exc:
        print(f"cargo shim: cannot exec real cargo at {real}: {exc}", file=sys.stderr)
        return 127


def main(argv: list[str]) -> int:
    root = nearest_policy_root(Path.cwd())
    if root is None:
        return exec_real_cargo(argv)

    policy_path = root / "ci" / "rust-verification.toml"
    try:
        policy = load_policy(policy_path)
    except (ValueError, OSError) as exc:
        print(
            f"cargo shim: cannot load or parse ci/rust-verification.toml [local_compile_policy]: {exc}",
            file=sys.stderr,
        )
        return 101
    if policy is None:
        return exec_real_cargo(argv)
    if "enabled" not in policy:
        print(
            "cargo shim: ci/rust-verification.toml [local_compile_policy].enabled is missing; "
            "local cargo guard disabled",
            file=sys.stderr,
        )
        return exec_real_cargo(argv)
    if policy.get("enabled") is not True:
        return exec_real_cargo(argv)

    try:
        refused = policy_refused_commands(policy)
    except ValueError as exc:
        print(f"cargo shim: invalid ci/rust-verification.toml [local_compile_policy]: {exc}", file=sys.stderr)
        return 101

    command = cargo_subcommand(argv)
    if command in refused and not bypass_enabled(policy):
        print(refusal_message(policy), file=sys.stderr, end="")
        return 101

    return exec_real_cargo(argv, root=root, policy_path=policy_path)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
