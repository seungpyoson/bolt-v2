#!/usr/bin/env python3
"""Install the cargo policy shim and make zsh start with it first in PATH."""

from __future__ import annotations

import os
import plistlib
import shutil
import stat
import sys
from pathlib import Path

import clean_merged_artifacts


BEGIN = "# BEGIN bolt cargo guard"
END = "# END bolt cargo guard"
LEGACY_START = "_rust_verification_env_unset_args() {"
LEGACY_CARGO_START = "cargo() {"
NO_MISTAKES_LAUNCH_AGENT_GLOB = "com.kunchenguid.no-mistakes.daemon.*.plist"


def quote(value: Path) -> str:
    escaped = str(value).replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`")
    return f'"{escaped}"'


def zshenv_path(home: Path | None = None) -> Path:
    zdotdir = os.environ.get("ZDOTDIR")
    if zdotdir:
        return Path(zdotdir).expanduser() / ".zshenv"
    if home is not None:
        return home / ".zshenv"
    try:
        return Path.home() / ".zshenv"
    except (RuntimeError, KeyError):
        return Path("~/.zshenv").expanduser()


def guard_block(install_dir: Path) -> str:
    return "\n".join(
        [
            BEGIN,
            "unfunction cargo 2>/dev/null || true",
            f"export BOLT_CARGO_SHIM_DIR={quote(install_dir)}",
            'case ":$PATH:" in',
            '  *":$BOLT_CARGO_SHIM_DIR:"*) ;;',
            '  *) export PATH="$BOLT_CARGO_SHIM_DIR:$PATH" ;;',
            "esac",
            END,
            "",
        ]
    )


def without_legacy_function_block(text: str) -> str:
    lines = text.splitlines()
    kept: list[str] = []
    i = 0
    while i < len(lines):
        if lines[i] == LEGACY_START:
            temp_i = i + 1
            saw_cargo = False
            found_end = False
            while temp_i < len(lines):
                line = lines[temp_i]
                if line == LEGACY_CARGO_START:
                    saw_cargo = True
                temp_i += 1
                if saw_cargo and line == "}":
                    while temp_i < len(lines) and lines[temp_i] == "":
                        temp_i += 1
                    found_end = True
                    break
            if found_end:
                i = temp_i
                continue
        kept.append(lines[i])
        i += 1
    stripped = "\n".join(kept).rstrip()
    return f"{stripped}\n" if stripped else ""


def without_existing_block(text: str) -> str:
    lines = without_legacy_function_block(text).splitlines()
    kept: list[str] = []
    skipping = False
    for line in lines:
        if line == BEGIN:
            skipping = True
            continue
        if skipping and line == END:
            skipping = False
            continue
        if not skipping:
            kept.append(line)
    stripped = "\n".join(kept).rstrip()
    return f"{stripped}\n\n" if stripped else ""


def install_shim(source: Path, install_dir: Path) -> Path:
    install_dir.mkdir(parents=True, exist_ok=True)
    target = install_dir / "cargo"
    shutil.copy2(source, target)
    target.chmod(target.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    return target


def atomic_write_bytes(path: Path, content: bytes) -> None:
    try:
        mode = path.stat().st_mode & 0o777
    except FileNotFoundError:
        mode = 0o644
    temp_path = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    try:
        with temp_path.open("wb") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        temp_path.chmod(mode)
        os.replace(temp_path, path)
    except Exception:
        try:
            temp_path.unlink()
        except Exception:
            pass
        raise


def update_zshenv(path: Path, install_dir: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    write_path = path.resolve() if path.is_symlink() else path
    write_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        existing = write_path.read_text(encoding="utf-8")
        mode = write_path.stat().st_mode & 0o777
    except FileNotFoundError:
        existing = ""
        mode = 0o644
    content = without_existing_block(existing) + guard_block(install_dir)
    temp_path = write_path.with_name(f".{write_path.name}.tmp-{os.getpid()}")
    try:
        with temp_path.open("w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        temp_path.chmod(mode)
        os.replace(temp_path, write_path)
    except Exception:
        try:
            temp_path.unlink()
        except Exception:
            pass
        raise


def launch_agents_dir(home: Path) -> Path:
    return home / "Library" / "LaunchAgents"


def no_mistakes_launch_agents(home: Path) -> list[Path]:
    return sorted(launch_agents_dir(home).glob(NO_MISTAKES_LAUNCH_AGENT_GLOB))


def daily_maintenance_install_root(root: Path) -> Path:
    main_root = clean_merged_artifacts._main_worktree_root(root)
    try:
        main_config = clean_merged_artifacts.load_config(main_root, use_main_worktree=False)
    except clean_merged_artifacts.ConfigError:
        if main_root == root:
            raise
        current_config = clean_merged_artifacts.load_config(root, use_main_worktree=False)
        if current_config.daily_maintenance_launch_agent is None:
            return main_root
        return root
    if main_config.daily_maintenance_launch_agent is not None:
        return main_root
    if main_root != root:
        current_config = clean_merged_artifacts.load_config(root, use_main_worktree=False)
        if current_config.daily_maintenance_launch_agent is not None:
            return root
    return main_root


def load_daily_maintenance_launch_agent_config(
    root: Path,
) -> clean_merged_artifacts.DailyMaintenanceLaunchAgentConfig:
    config_root = daily_maintenance_install_root(root)
    config = clean_merged_artifacts.load_config(config_root, use_main_worktree=False)
    if config.daily_maintenance_launch_agent is None:
        raise ValueError("missing config: clean-merged.daily_maintenance_launch_agent")
    return config.daily_maintenance_launch_agent


def daily_maintenance_launch_agent_path(
    home: Path, config: clean_merged_artifacts.DailyMaintenanceLaunchAgentConfig,
) -> Path:
    return launch_agents_dir(home) / f"{config.label}.plist"


def daily_maintenance_launch_agent_payload(
    root: Path,
    install_dir: Path,
    config: clean_merged_artifacts.DailyMaintenanceLaunchAgentConfig,
) -> dict[str, object]:
    replacements = {
        "<git-common-dir>": str(clean_merged_artifacts.git_common_dir(root)),
        "<repo-root>": str(root),
        "<shim-dir>": str(install_dir),
    }
    environment_path = replace_launch_agent_placeholders(config.environment_path, replacements)
    standard_out_path = replace_launch_agent_placeholders(config.standard_out_path, replacements)
    standard_error_path = replace_launch_agent_placeholders(config.standard_error_path, replacements)
    return {
        "Label": config.label,
        "ProgramArguments": list(config.program_arguments),
        "WorkingDirectory": str(root),
        "EnvironmentVariables": {"PATH": environment_path},
        "StandardOutPath": standard_out_path,
        "StandardErrorPath": standard_error_path,
        "StartCalendarInterval": dict(config.start_calendar_interval),
    }


def replace_launch_agent_placeholders(value: str, replacements: dict[str, str]) -> str:
    resolved = value
    for placeholder, replacement in replacements.items():
        resolved = resolved.replace(placeholder, replacement)
    return resolved


def install_daily_maintenance_launch_agent(
    home: Path,
    root: Path,
    install_dir: Path,
    config: clean_merged_artifacts.DailyMaintenanceLaunchAgentConfig,
) -> Path:
    plist_path = daily_maintenance_launch_agent_path(home, config)
    plist_path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write_bytes(plist_path, plistlib.dumps(daily_maintenance_launch_agent_payload(root, install_dir, config)))
    return plist_path


def path_with_shim_first(existing_path: str, install_dir: Path) -> str:
    shim_dir = str(install_dir)
    entries = [entry for entry in existing_path.split(os.pathsep) if entry and entry != shim_dir]
    return os.pathsep.join([shim_dir, *entries])


def update_no_mistakes_launch_agents(home: Path, install_dir: Path) -> list[Path]:
    configured: list[Path] = []
    for plist_path in no_mistakes_launch_agents(home):
        try:
            payload = plistlib.loads(plist_path.read_bytes())
            env = payload.setdefault("EnvironmentVariables", {})
            if not isinstance(env, dict):
                raise ValueError("EnvironmentVariables must be a dictionary")
            current_path = env.get("PATH")
            if current_path is None or current_path == "":
                print(
                    f"Skipping no-mistakes LaunchAgent PATH update for {plist_path}: "
                    "EnvironmentVariables.PATH is missing or empty.",
                    file=sys.stderr,
                )
                continue
            if not isinstance(current_path, str):
                raise ValueError("EnvironmentVariables.PATH must be a string")
            next_path = path_with_shim_first(current_path, install_dir)
            if next_path != current_path:
                env["PATH"] = next_path
                atomic_write_bytes(plist_path, plistlib.dumps(payload))
            configured.append(plist_path)
        except Exception as exc:
            raise ValueError(f"Failed to update no-mistakes LaunchAgent PATH for {plist_path}: {exc}") from None
    return configured


def main() -> int:
    root = daily_maintenance_install_root(Path(__file__).resolve().parents[1])
    source = root / "scripts" / "cargo-shim"
    install_dir = Path(os.environ.get("BOLT_CARGO_SHIM_DIR", "~/.local/bin/bolt-cargo-shim")).expanduser()
    try:
        target = install_shim(source, install_dir)
    except OSError as exc:
        print(f"Failed to install cargo shim: {exc}", file=sys.stderr)
        return 1
    try:
        home = Path.home()
    except (RuntimeError, KeyError) as exc:
        print(f"Failed to resolve home directory: {exc}", file=sys.stderr)
        return 1
    zshenv = zshenv_path(home)
    try:
        update_zshenv(zshenv, install_dir)
    except OSError as exc:
        print(f"Failed to update zsh startup: {exc}", file=sys.stderr)
        return 1
    try:
        no_mistakes_plists = update_no_mistakes_launch_agents(home, install_dir)
    except ValueError as exc:
        print(exc, file=sys.stderr)
        return 1
    try:
        daily_maintenance_config = load_daily_maintenance_launch_agent_config(root)
    except (OSError, ValueError) as exc:
        print(f"Failed to load daily maintenance LaunchAgent config: {exc}", file=sys.stderr)
        return 1
    try:
        daily_maintenance_plist = install_daily_maintenance_launch_agent(
            home, root, install_dir, daily_maintenance_config,
        )
    except OSError as exc:
        print(f"Failed to install daily maintenance LaunchAgent: {exc}", file=sys.stderr)
        return 1
    print(f"Installed cargo shim: {target}")
    print(f"Updated zsh startup: {zshenv}")
    for plist_path in no_mistakes_plists:
        print(f"Updated no-mistakes LaunchAgent PATH: {plist_path}")
    print(f"Installed daily maintenance LaunchAgent: {daily_maintenance_plist}")
    print("Restart or reconfigure long-running agent daemons after install; existing processes keep their old PATH.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
